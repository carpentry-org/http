(load "Test.carp")
(load "../http.carp")
(use Test)

(def simple-get @"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
(def post-with-body
  @"POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: 13\r\n\r\n{\"key\":\"val\"}")
(def multi-header
  @"GET / HTTP/1.1\r\nHost: localhost\r\nAccept: text/html\r\nAccept: application/json\r\n\r\n")
(def with-cookies
  @"GET / HTTP/1.1\r\nHost: localhost\r\nCookie: a=1;b=2\r\n\r\n")

; ---- cookie expiry test helpers ----
(defn expiry-verdict [s]
  (match (Cookie.parse-set s)
    (Result.Success c) (if (Cookie.expired? &c) @"expired" @"live")
    (Result.Error e) e))

(defn expiry-verdict-at [s t]
  (match (Cookie.parse-set s)
    (Result.Success c) (if (Cookie.expired-at? &c t) @"expired" @"live")
    (Result.Error e) e))

(defn zoned [year month day hours zone delta]
  (Datetime.init year
                 month
                 day
                 (Maybe.Just hours)
                 (Maybe.Just 0)
                 (Maybe.Just 0)
                 (Maybe.Nothing)
                 (Maybe.Just (Timezone.init zone delta false))))

(defn parse-verb [s]
  (match (Request.parse s) (Result.Success r) @(Request.verb &r) _ @""))

(defn parse-version [s]
  (match (Request.parse s) (Result.Success r) @(Request.version &r) _ @""))

(defn parse-body [s]
  (match (Request.parse s) (Result.Success r) @(Request.body &r) _ @""))

(defn resp-code [s]
  (match (Response.parse s) (Result.Success r) @(Response.code &r) _ -1))

(defn resp-body [s]
  (match (Response.parse s) (Result.Success r) @(Response.body &r) _ @""))

; ---- multipart/form-data + MediaType test helpers ----
(defn mp-parts [body boundary]
  (match (Multipart.parse body boundary)
    (Result.Success ps) ps
    (Result.Error _) []))
(defn mp-name [ps i] @(FormPart.name (Array.unsafe-nth ps i)))
(defn mp-body [ps i] @(FormPart.body (Array.unsafe-nth ps i)))
(defn mp-fname [ps i]
  (Maybe.from @(FormPart.filename (Array.unsafe-nth ps i)) @"<none>"))
(defn mp-ctype [ps i]
  (Maybe.from @(FormPart.content-type (Array.unsafe-nth ps i)) @"<none>"))

(def mp-text
  @"--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello\r\n--b--\r\n")
(def mp-file
  @"--b\r\nContent-Disposition: form-data; name=\"f\"; filename=\"up.txt\"\r\nContent-Type: text/plain\r\n\r\ndata\r\n--b--\r\n")
(def mp-two
  @"--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n--b\r\nContent-Disposition: form-data; name=\"c\"\r\n\r\n2\r\n--b--\r\n")

; ---- content negotiation (Accept) test helpers ----
(defn pick [accept offers]
  (match (Accept.negotiate accept offers)
    (Maybe.Just m) m
    (Maybe.Nothing) @"NONE"))

(defn range-mime [s i]
  (let [rs (Accept.parse s)]
    (fmt "%s/%s"
         (MediaRange.type (Array.unsafe-nth &rs i))
         (MediaRange.subtype (Array.unsafe-nth &rs i)))))

(defn req-pick [accept offers]
  (let [r (Request.get (URI.zero) [] {@"Accept" [@accept]} @"")]
    (match (Request.negotiate &r offers)
      (Maybe.Just m) m
      (Maybe.Nothing) @"NONE")))

(defn req-pick-noaccept [offers]
  (let [r (Request.get (URI.zero) [] (the (Map String (Array String)) {}) @"")]
    (match (Request.negotiate &r offers)
      (Maybe.Just m) m
      (Maybe.Nothing) @"NONE")))

(defn req-parse-pick [s offers]
  (match (Request.parse s)
    (Result.Success r)
      (match (Request.negotiate &r offers)
        (Maybe.Just m) m
        (Maybe.Nothing) @"NONE")
    _ @"PARSE-FAIL"))

(defn pick-enc [accept offers]
  (match (AcceptEncoding.negotiate accept offers)
    (Maybe.Just c) c
    (Maybe.Nothing) @"NONE"))

(defn pick-lang [accept offers]
  (match (AcceptLanguage.negotiate accept offers)
    (Maybe.Just l) l
    (Maybe.Nothing) @"NONE"))

(defn req-pick-enc [hdrs offers]
  (let [r (Request.get (URI.zero) [] hdrs @"")]
    (match (Request.negotiate-encoding &r offers)
      (Maybe.Just c) c
      (Maybe.Nothing) @"NONE")))

(defn req-pick-lang [hdrs offers]
  (let [r (Request.get (URI.zero) [] hdrs @"")]
    (match (Request.negotiate-language &r offers)
      (Maybe.Just l) l
      (Maybe.Nothing) @"NONE")))

(defn weighted-entry [es i]
  (let [e (Array.unsafe-nth es i)]
    (fmt "%s@%.1f" (Weighted.value e) @(Weighted.q e))))
; ---- chunked transfer-encoding test helpers ----
(defn dechunk-ok [s]
  (match (TransferEncoding.dechunk s) (Result.Success b) b _ @"FAIL"))

(defn dechunk-err? [s]
  (match (TransferEncoding.dechunk s) (Result.Error _) true _ false))

(defn chunk-rt? [s size]
  (match (TransferEncoding.dechunk &(TransferEncoding.chunk-with-size s size))
    (Result.Success b) (= &b s)
    (Result.Error _) false))

(defn resp-chunked? [s]
  (match (Response.parse s) (Result.Success r) (Response.chunked? &r) _ false))

(defn req-chunked? [s]
  (match (Request.parse s) (Result.Success r) (Request.chunked? &r) _ false))

(defn cookie-base []
  (Cookie.init @"sid"
               @"xyz"
               @"/"
               (Maybe.Nothing)
               (Maybe.Nothing)
               false
               false
               (SameSite.Lax)))

(defn cookie-expires-fixture []
  (Datetime.init 2021
                 6
                 9
                 (Maybe.Just 10)
                 (Maybe.Just 18)
                 (Maybe.Just 14)
                 (Maybe.Nothing)
                 (Maybe.Nothing)))

(defn cookie-roundtrip [c] (Cookie.parse-set &(Cookie.set &c)))

; ---- HTTP-date test helpers ----
; renders a parsed date as `YYYY-MM-DD HH:MM:SS`, or the error message
(defn http-date [s]
  (match (HttpDate.parse s)
    (Result.Success d) (Datetime.strftime &d "%Y-%m-%d %H:%M:%S")
    (Result.Error e) e))

(defn cookie-expiry [s]
  (match (Cookie.parse-set s)
    (Result.Success c)
      (match @(Cookie.expires &c)
        (Maybe.Just d) (Datetime.strftime &d "%Y-%m-%d %H:%M:%S")
        (Maybe.Nothing) @"no expiry")
    (Result.Error e) e))

(defn resp-cookie-expiry [s]
  (match (Response.parse s)
    (Result.Success r)
      (let [cs (Response.cookies &r)]
        (if (Array.empty? cs)
          @"no cookie"
          (match @(Cookie.expires (Array.unsafe-first cs))
            (Maybe.Just d) (Datetime.strftime &d "%Y-%m-%d %H:%M:%S")
            (Maybe.Nothing) @"no expiry")))
    (Result.Error e) e))

; ---- auth test helpers ----
; renders parsed challenges as `scheme token/name=value`, joined by `|`
(defn chal-summary [s]
  (let-do [cs (Auth.parse-challenges s)
           sb (StringBuf.create)]
    (for [i 0 (Array.length &cs)]
      (let-do [c (Array.unsafe-nth &cs i)]
        (when (> i 0) (StringBuf.append-char &sb \|))
        (StringBuf.append-str &sb (Credentials.scheme c))
        (unless-do (String.empty? (Credentials.token c))
          (StringBuf.append-char &sb \space)
          (StringBuf.append-str &sb (Credentials.token c)))
        (for [j 0 (Array.length (Credentials.params c))]
          (let-do [p (Array.unsafe-nth (Credentials.params c) j)]
            (StringBuf.append-char &sb \/)
            (StringBuf.append-str &sb (Pair.a p))
            (StringBuf.append-char &sb \=)
            (StringBuf.append-str &sb (Pair.b p))))))
    (let-do [r (StringBuf.to-string &sb)] (StringBuf.delete sb) r)))

(defn chal-count [s] (Array.length &(Auth.parse-challenges s)))

(defn chal-realm [s i]
  (let [cs (Auth.parse-challenges s)]
    (if (<= (Array.length &cs) i)
      @"<none>"
      (Maybe.from (Credentials.realm (Array.unsafe-nth &cs i)) @"<none>"))))

(defn auth-roundtrip [s]
  (let-do [cs (Auth.parse-challenges s)
           sb (StringBuf.create)]
    (for [i 0 (Array.length &cs)]
      (do
        (when (> i 0) (StringBuf.append-str &sb ", "))
        (StringBuf.append-str &sb &(Credentials.str (Array.unsafe-nth &cs i)))))
    (let-do [r (StringBuf.to-string &sb)] (StringBuf.delete sb) r)))

(defn auth-scheme-is? [s name]
  (match (Auth.parse s)
    (Result.Success c) (Credentials.scheme-is? &c name)
    (Result.Error _) false))

(defn basic-parts [s]
  (match (Auth.parse s)
    (Result.Error e) e
    (Result.Success c)
      (match (Auth.basic-credentials &c)
        (Result.Error e) e
        (Result.Success up) (fmt "%s/%s" (Pair.a &up) (Pair.b &up)))))

(defn bearer-of [s]
  (match (Auth.parse s)
    (Result.Error e) e
    (Result.Success c)
      (match (Auth.bearer-token &c) (Result.Error e) e (Result.Success t) t)))

(defn auth-verdict [s]
  (match (Auth.parse s) (Result.Success _) @"<ok>" (Result.Error e) e))

(defn basic-header [u p]
  (match (Auth.basic u p) (Result.Success h) h (Result.Error e) e))

(defn basic-header-roundtrip [u p] (basic-parts &(basic-header u p)))

(defn repeated [s n]
  (let-do [sb (StringBuf.create)]
    (for [i 0 n] (StringBuf.append-str &sb s))
    (let-do [r (StringBuf.to-string &sb)] (StringBuf.delete sb) r)))

(defn unauthorized-header [challenge headers]
  (Maybe.from
    (Response.header
      &(Response.unauthorized challenge headers @"")
      "WWW-Authenticate")
    @"<none>"))

(defn range-verdict [s]
  (match (ByteRange.parse s)
    (Result.Success specs) (ByteRange.str &specs)
    (Result.Error _) @"ERROR"))

(defn range-error [s]
  (match (ByteRange.parse s) (Result.Success _) @"<none>" (Result.Error e) e))

(defn pair-str [p] (fmt "%s-%s" &(Long.str @(Pair.a p)) &(Long.str @(Pair.b p))))

(defn resolved [s len]
  (match (ByteRange.parse s)
    (Result.Success specs)
      (let-do [rs (ByteRange.resolve &specs len)
               out @""]
        (for [i 0 (Array.length &rs)]
          (do
            (when (> i 0) (set! out (String.append &out ",")))
            (set! out (String.append &out &(pair-str (Array.unsafe-nth &rs i))))))
        out)
    (Result.Error _) @"ERROR"))

(defn spec-bound [s i]
  (match (ByteRange.parse s)
    (Result.Success specs)
      (match-ref (Array.unsafe-nth &specs i)
        (ByteRangeSpec.FirstLast _ b) @b
        (ByteRangeSpec.From a) @a
        (ByteRangeSpec.Suffix n) @n)
    (Result.Error _) -1l))

(defn content-range-verdict [s]
  (match (ContentRange.parse s)
    (Result.Success cr) (ContentRange.str &cr)
    (Result.Error _) @"ERROR"))

(defn content-range-error [s]
  (match (ContentRange.parse s) (Result.Success _) @"<none>" (Result.Error e) e))

(defn req-range-verdict [hdrs]
  (let [r (Request.get (URI.zero) [] hdrs @"")]
    (match (Request.range &r)
      (Maybe.Nothing) @"NONE"
      (Maybe.Just (Result.Error _)) @"ERROR"
      (Maybe.Just (Result.Success specs)) (ByteRange.str &specs))))

; ---- conditional request test helpers ----
(defn etag-verdict [s]
  (match (ETag.parse s)
    (Result.Success e) (ETag.str &e)
    (Result.Error _) @"ERROR"))

(defn tags-verdict [s]
  (match (ETagList.parse s)
    (Result.Error _) @"ERROR"
    (Result.Success l)
      (match l
        (ETagList.Any) @"*"
        (ETagList.Tags ts) (String.join ", " &(Array.copy-map &ETag.str &ts)))))

(defn some-etag [v weak] (Maybe.Just (ETag.init @v weak)))

(defn no-etag [] (the (Maybe ETag) (Maybe.Nothing)))

(defn at [s] (Result.to-maybe (HttpDate.parse s)))

(defn no-date [] (the (Maybe Datetime) (Maybe.Nothing)))

(defn no-headers [] (the (Map String (Array String)) {}))

(defn precondition [hdrs method etag modified]
  (match (Precondition.evaluate &hdrs method etag modified)
    (Maybe.Nothing) @"OK"
    (Maybe.Just code) (Int.str code)))

(defn req-precondition [hdrs method etag modified]
  (let [r (Request.init @method @"HTTP/1.1" (URI.zero) [] hdrs @"")]
    (match (Request.preconditions &r etag modified)
      (Maybe.Nothing) @"OK"
      (Maybe.Just code) (Int.str code))))

(defn if-range? [v etag modified]
  (Precondition.if-range-matches?
    &{@"Range" [@"bytes=0-499"]
      @"If-Range" [@v]}
    etag
    modified))

; ---- hostile-byte test helpers ----
; a run of UTF-8 continuation bytes: `n` bytes long, zero characters long
(defn continuation [n] (String.from-bytes &(Array.replicate n &128b)))

(defn ctype-param [s k]
  (Maybe.from (Map.get-maybe &(MediaType.parse-params s) k) @"<none>"))

(defn cc-directive [s k]
  (Maybe.from (Map.get-maybe &(CacheControl.parse s) k) @"<none>"))

(defn cookie-summary [s]
  (match (Cookie.parse-set s)
    (Result.Success c) (fmt "%s=%s" (Cookie.name &c) (Cookie.value &c))
    (Result.Error e) e))

(defn resp-cookie-summary [s]
  (match (Response.parse s)
    (Result.Success r)
      (let [cs (Response.cookies &r)]
        (if (Array.empty? cs)
          @"no cookie"
          (let [c (Array.unsafe-first cs)]
            (fmt "%s=%s" (Cookie.name c) (Cookie.value c)))))
    (Result.Error e) e))

; ---- request-target test helpers ----
(defn request-line [s]
  (match (URI.parse s)
    (Result.Success u) (Request.str &(Request.get u [] {} @""))
    (Result.Error e) e))

(deftest test
  (assert-true test
    (match (Request.parse &simple-get) (Result.Success _) true _ false)
    "parse simple GET succeeds")

  (assert-equal test &(parse-verb &simple-get) "GET" "parse extracts verb")

  (assert-equal test
    &(parse-version &simple-get)
    "HTTP/1.1"
    "parse extracts version")

  (assert-equal test
    &(parse-body &post-with-body)
    "{\"key\":\"val\"}"
    "parse extracts body")

  (assert-equal test &(parse-verb &post-with-body) "POST" "parse POST verb")

  (assert-equal test
    2
    (match (Request.parse &multi-header)
      (Result.Success r)
        (Array.length &(Map.get-with-default (Request.headers &r) "Accept" &[]))
      _ 0)
    "multiple Accept headers collected")

  (assert-equal test
    2
    (match (Request.parse &with-cookies)
      (Result.Success r) (Array.length (Request.cookies &r))
      _ 0)
    "cookies parsed from Cookie header")

  (assert-true test
    (match (Request.parse "") (Result.Error _) true _ false)
    "empty string returns error")

  (assert-true test
    (match (Request.parse "garbage") (Result.Error _) true _ false)
    "garbage returns error")

  (assert-equal test
    200
    (resp-code "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi")
    "parse 200 response code")

  (assert-equal test
    &(resp-body "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi")
    "hi"
    "parse response body")

  (assert-equal test
    404
    (resp-code "HTTP/1.1 404 Not Found\r\n\r\n")
    "parse 404 response")

  (assert-true test
    (Response.ok? &(Response.init 200 @"OK" @"HTTP/1.1" [] {} @""))
    "ok? true for 200")

  (assert-true test
    (Response.client-error?
      &(Response.init 404 @"Not Found" @"HTTP/1.1" [] {} @""))
    "client-error? true for 404")

  (assert-true test
    (Response.server-error? &(Response.init 500 @"ISE" @"HTTP/1.1" [] {} @""))
    "server-error? true for 500")

  (assert-equal test
    &(let [req (Request.get (URI.zero) [] {} @"")]
      (match (Request.parse &(Request.str &req))
        (Result.Success r) @(Request.verb &r)
        _ @""))
    "GET"
    "request roundtrip preserves verb")

  (assert-equal test
    "GET / HTTP/1.1\r\n\r\n"
    &(Request.str &(Request.get (URI.zero) [] {} @""))
    "request-target of an empty path is /")

  (assert-equal test
    "GET /?a=1 HTTP/1.1\r\n\r\n"
    &(Request.str
      &(Request.get (URI.set-query (URI.zero) (Maybe.Just @"a=1")) [] {} @""))
    "request-target of a query-only URI keeps its leading /")

  (assert-equal test
    "GET http://example.com HTTP/1.1\r\n\r\n"
    &(Request.str
      &(Request.get
        (URI.set-scheme
          (URI.set-host (URI.zero) (Maybe.Just @"example.com"))
          (Maybe.Just @"http"))
        []
        {}
        @""))
    "absolute-form request-target is left alone")

  (assert-equal test
    "GET http://h.example/a/c HTTP/1.1\r\n\r\n"
    &(request-line "http://USER:PW@h.example/a/c")
    "request-target drops user and password")

  (assert-equal test
    "GET http://h.example/a/c HTTP/1.1\r\n\r\n"
    &(request-line "http://USER@h.example/a/c")
    "request-target drops a user without a password")

  (assert-equal test
    "GET http://h.example/a/c HTTP/1.1\r\n\r\n"
    &(request-line "http://h.example/a/c")
    "request-target without userinfo is unchanged")

  (assert-equal test
    "GET / HTTP/1.1\r\n\r\n"
    &(Request.str
      &(Request.get (URI.set-user (URI.zero) (Maybe.Just @"solo")) [] {} @""))
    "request-target of a userinfo-only URI is /")

  (assert-true test
    (match (URI.parse "http://USER:PW@h.example/a/c")
      (Result.Success u)
        (let [r (Request.get u [] {} @"")]
          (and
            (= &(Maybe.Just @"USER") (URI.user (Request.uri &r)))
            (= &(Maybe.Just @"PW") (URI.password (Request.uri &r)))))
      _ false)
    "the credentials stay on the request’s URI")

  (assert-equal test
    "GET http://h.example/a/b?q=1 HTTP/1.1\r\n\r\n"
    &(request-line "http://h.example/a/b?q=1#sec2")
    "request-target drops a fragment and keeps the query")

  (assert-equal test
    "GET http://h.example/a/b HTTP/1.1\r\n\r\n"
    &(request-line "http://h.example/a/b#sec2")
    "request-target drops a fragment without a query")

  (assert-equal test
    "GET http://h.example/a/b HTTP/1.1\r\n\r\n"
    &(request-line "http://h.example/a/b#")
    "request-target drops an empty fragment")

  (assert-equal test
    "GET http://h.example/a/b HTTP/1.1\r\n\r\n"
    &(request-line "http://h.example/a/b#frag?notquery")
    "request-target drops a fragment that looks like a query")

  (assert-equal test
    "GET http://h.example/a/b?q=a%23b HTTP/1.1\r\n\r\n"
    &(request-line "http://h.example/a/b?q=a%23b")
    "request-target keeps an encoded # inside the query")

  (assert-equal test
    "GET /?q=a#b HTTP/1.1\r\n\r\n"
    &(Request.str
      &(Request.get (URI.set-query (URI.zero) (Maybe.Just @"q=a#b")) [] {} @""))
    "request-target keeps a literal # inside the query")

  (assert-equal test
    "GET / HTTP/1.1\r\n\r\n"
    &(Request.str
      &(Request.get (URI.set-fragment (URI.zero) (Maybe.Just @"sec2")) [] {} @""))
    "request-target of a fragment-only URI is /")

  (assert-true test
    (match (URI.parse "http://h.example/a/b#sec2")
      (Result.Success u)
        (= &(Maybe.Just @"sec2")
           (URI.fragment (Request.uri &(Request.get u [] {} @""))))
      _ false)
    "the fragment stays on the request’s URI")

  (assert-true test
    (match (Cookie.parse "name=value")
      (Result.Success c)
        (and (= (Cookie.name &c) "name") (= (Cookie.value &c) "value"))
      _ false)
    "parse simple cookie")

  (assert-true test
    (match (Cookie.parse "bad") (Result.Error _) true _ false)
    "malformed cookie returns error")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Expires=Wed, 09 Jun 2021 10:18:14 GMT")
      (Result.Success c)
        (match @(Cookie.expires &c)
          (Maybe.Just d)
            (and (= 2021 @(Datetime.year &d))
                 (and (= 6 @(Datetime.month &d)) (= 9 @(Datetime.day &d))))
          (Maybe.Nothing) false)
      _ false)
    "parse-set extracts Expires date")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Expires=not a real date")
      (Result.Error _) true
      _ false)
    "parse-set rejects malformed Expires date")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Partitioned")
      (Result.Success c) (= (Cookie.name &c) "id")
      _ false)
    "parse-set ignores unknown attribute Partitioned")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Priority=High")
      (Result.Success c) (= (Cookie.value &c) "abc")
      _ false)
    "parse-set ignores unknown attribute Priority=High")

  (assert-true test
    (match (Cookie.parse-set
        "id=abc; Path=/; Partitioned; Secure; Priority=High")
      (Result.Success c) (and (= (Cookie.path &c) "/") @(Cookie.secure &c))
      _ false)
    "parse-set handles mix of known and unknown attributes")

  (assert-true test
    (match (Cookie.parse-set "id=abc; secure")
      (Result.Success c) @(Cookie.secure &c)
      _ false)
    "parse-set honors lowercase Secure attribute")

  (assert-true test
    (match (Cookie.parse-set "id=abc; httponly")
      (Result.Success c) @(Cookie.httponly &c)
      _ false)
    "parse-set honors lowercase HttpOnly attribute")

  (assert-true test
    (match (Cookie.parse-set "id=abc; PaTh=/Foo")
      (Result.Success c) (= (Cookie.path &c) "/Foo")
      _ false)
    "parse-set honors mixed-case Path attribute and preserves value case")

  (assert-true test
    (match (Cookie.parse-set "id=abc; domain=Example.com")
      (Result.Success c)
        (match @(Cookie.domain &c)
          (Maybe.Just d) (= &d "Example.com")
          (Maybe.Nothing) false)
      _ false)
    "parse-set honors lowercase Domain attribute and preserves value case")

  (assert-true test
    (match (Cookie.parse-set "id=abc; max-age=60")
      (Result.Success c)
        (match @(Cookie.expires &c) (Maybe.Just _) true (Maybe.Nothing) false)
      _ false)
    "parse-set honors lowercase Max-Age attribute")

  (assert-true test
    (match (Cookie.parse-set "id=abc; expires=Wed, 09 Jun 2021 10:18:14 GMT")
      (Result.Success c)
        (match @(Cookie.expires &c)
          (Maybe.Just d)
            (and (= 2021 @(Datetime.year &d))
                 (and (= 6 @(Datetime.month &d)) (= 9 @(Datetime.day &d))))
          (Maybe.Nothing) false)
      _ false)
    "parse-set honors lowercase Expires attribute")

  (assert-true test
    (match (Cookie.parse-set "id=abc; SameSite=lax")
      (Result.Success c)
        (match @(Cookie.samesite &c) (SameSite.Lax) true _ false)
      _ false)
    "parse-set honors lowercase SameSite value lax")

  (assert-true test
    (match (Cookie.parse-set "id=abc; SameSite=strict")
      (Result.Success c)
        (match @(Cookie.samesite &c) (SameSite.Strict) true _ false)
      _ false)
    "parse-set honors lowercase SameSite value strict")

  (assert-true test
    (match (Cookie.parse-set "id=abc; SameSite=none")
      (Result.Success c)
        (match @(Cookie.samesite &c) (SameSite.None) true _ false)
      _ false)
    "parse-set honors lowercase SameSite value none")

  (assert-true test
    (match (Response.parse
        "HTTP/1.1 200 OK\r\nSet-Cookie: id=abc; SameSite=lax\r\n\r\n")
      (Result.Success r) (= 1 (Array.length (Response.cookies &r)))
      _ false)
    "lowercase SameSite value does not abort Response.parse")

  (assert-true test
    (match (Cookie.parse-set "id=abc; partitioned")
      (Result.Success c) (= (Cookie.name &c) "id")
      _ false)
    "parse-set still ignores a genuinely unknown attribute (lowercase)")

  (assert-true test
    (match (Cookie.parse "session=YWJjZA==")
      (Result.Success c)
        (and (= (Cookie.name &c) "session") (= (Cookie.value &c) "YWJjZA=="))
      _ false)
    "parse handles '=' in cookie value")

  (assert-true test
    (match (cookie-roundtrip (cookie-base))
      (Result.Success c)
        (and (= (Cookie.name &c) "sid")
             (and (= (Cookie.value &c) "xyz") (= (Cookie.path &c) "/")))
      _ false)
    "Cookie.set round-trips name, value, and default Path")

  (assert-true test
    (match (cookie-roundtrip (Cookie.set-path (cookie-base) @"/admin"))
      (Result.Success c) (= (Cookie.path &c) "/admin")
      _ false)
    "Cookie.set round-trips a custom Path")

  (assert-true test
    (match (cookie-roundtrip
        (Cookie.set-domain (cookie-base) (Maybe.Just @"example.com")))
      (Result.Success c)
        (match @(Cookie.domain &c)
          (Maybe.Just d) (= &d "example.com")
          (Maybe.Nothing) false)
      _ false)
    "Cookie.set round-trips a Domain")

  (assert-true test
    (match (cookie-roundtrip (Cookie.set-secure (cookie-base) true))
      (Result.Success c) @(Cookie.secure &c)
      _ false)
    "Cookie.set round-trips Secure")

  (assert-true test
    (match (cookie-roundtrip (Cookie.set-httponly (cookie-base) true))
      (Result.Success c) @(Cookie.httponly &c)
      _ false)
    "Cookie.set round-trips HttpOnly")

  (assert-true test
    (match (cookie-roundtrip (Cookie.set-samesite (cookie-base) (SameSite.Lax)))
      (Result.Success c)
        (match @(Cookie.samesite &c) (SameSite.Lax) true _ false)
      _ false)
    "Cookie.set round-trips SameSite=Lax")

  (assert-true test
    (match (cookie-roundtrip
        (Cookie.set-samesite (cookie-base) (SameSite.Strict)))
      (Result.Success c)
        (match @(Cookie.samesite &c) (SameSite.Strict) true _ false)
      _ false)
    "Cookie.set round-trips SameSite=Strict")

  (assert-true test
    (match (cookie-roundtrip (Cookie.set-samesite (cookie-base) (SameSite.None)))
      (Result.Success c)
        (match @(Cookie.samesite &c) (SameSite.None) true _ false)
      _ false)
    "Cookie.set round-trips SameSite=None")

  (assert-true test
    (match (cookie-roundtrip
        (Cookie.set-expires (cookie-base) (Maybe.Just (cookie-expires-fixture))))
      (Result.Success c)
        (match @(Cookie.expires &c)
          (Maybe.Just d) (Datetime.= &d &(cookie-expires-fixture))
          (Maybe.Nothing) false)
      _ false)
    "Cookie.set round-trips an Expires datetime")

  (assert-true test
    (match (cookie-roundtrip
        (Cookie.init @"sid"
                     @"xyz"
                     @"/admin"
                     (Maybe.Just (cookie-expires-fixture))
                     (Maybe.Just @"example.com")
                     true
                     true
                     (SameSite.Strict)))
      (Result.Success c)
        (and (= (Cookie.name &c) "sid")
             (and (= (Cookie.value &c) "xyz")
                  (and (= (Cookie.path &c) "/admin")
                       (and @(Cookie.secure &c)
                            (and @(Cookie.httponly &c)
                                 (and
                                   (match @(Cookie.samesite &c)
                                     (SameSite.Strict) true
                                     _ false)
                                   (and
                                     (match @(Cookie.domain &c)
                                       (Maybe.Just d) (= &d "example.com")
                                       (Maybe.Nothing) false)
                                     (match @(Cookie.expires &c)
                                       (Maybe.Just d)
                                         (Datetime.= &d
                                                     &(cookie-expires-fixture))
                                       (Maybe.Nothing) false))))))))
      _ false)
    "Cookie.set round-trips all attributes together")

  (assert-equal test
    2
    (match (Request.parse "GET / HTTP/1.1\r\ncookie: a=1;b=2\r\n\r\n")
      (Result.Success r) (Array.length (Request.cookies &r))
      _ 0)
    "lowercase 'cookie:' header is recognized")

  (assert-equal test
    1
    (match (Response.parse "HTTP/1.1 200 OK\r\nset-cookie: id=abc\r\n\r\n")
      (Result.Success r) (Array.length (Response.cookies &r))
      _ 0)
    "lowercase 'set-cookie:' header is recognized")

  (assert-equal test 200 Status.ok "Status.ok is 200")

  (assert-equal test 404 Status.not-found "Status.not-found is 404")

  (assert-equal test &(Status.reason 404) "Not Found" "Status.reason for 404")

  (assert-equal test &(Status.reason 200) "OK" "Status.reason for 200")

  (assert-equal test
    &(Status.reason 999)
    "Unknown"
    "Status.reason for unknown code")

  (assert-true test
    (match (Request.parse "GET / HTTP/1.1\r\nContent-Type: text/html\r\n\r\n")
      (Result.Success r)
        (match (Request.header &r "content-type")
          (Maybe.Just v) (= &v "text/html")
          _ false)
      _ false)
    "header lookup is case-insensitive")

  (assert-true test
    (match (Request.parse "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
      (Result.Success r) (Maybe.nothing? &(Request.header &r "X-Missing"))
      _ false)
    "header returns Nothing for missing key")

  (assert-equal test
    "carp"
    &(match (the (Result (Map String String) String)
                 (Form.parse "name=carp&version=1"))
      (Result.Success m) (Map.get &m "name")
      _ @"")
    "Form.parse extracts key")

  (assert-equal test
    "1"
    &(match (the (Result (Map String String) String)
                 (Form.parse "name=carp&version=1"))
      (Result.Success m) (Map.get &m "version")
      _ @"")
    "Form.parse extracts second key")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Form.parse "msg=hello%20world"))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "Form.parse decodes percent-encoded space")

  (assert-equal test
    ""
    &(match (the (Result (Map String String) String) (Form.parse "flag"))
      (Result.Success m) (Map.get &m "flag")
      _ @"FAIL")
    "Form.parse handles key without value")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Form.parse "msg=hello+world"))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "Form.parse decodes + as space")

  (assert-equal test
    "a b c"
    &(match (the (Result (Map String String) String) (Form.parse "x=a+b+c"))
      (Result.Success m) (Map.get &m "x")
      _ @"")
    "Form.parse decodes multiple + as spaces")

  (assert-equal test
    "+"
    &(match (the (Result (Map String String) String) (Form.parse "x=%2B"))
      (Result.Success m) (Map.get &m "x")
      _ @"")
    "Form.parse decodes %2B as literal +")

  (assert-equal test
    "a b"
    &(match (the (Result (Map String String) String) (Form.parse "key+name=a+b"))
      (Result.Success m) (Map.get &m "key name")
      _ @"")
    "Form.parse decodes + in keys too")

  (assert-true test
    (Request.ignore-body? &(Request.request @"HEAD" (URI.zero) [] {} @""))
    "ignore-body? true for HEAD")

  (assert-false test
    (Request.ignore-body? &(Request.request @"GET" (URI.zero) [] {} @""))
    "ignore-body? false for GET")

  (assert-false test
    (Request.ignore-body? &(Request.request @"POST" (URI.zero) [] {} @"body"))
    "ignore-body? false for POST")

  (assert-equal test
    "bar"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"foo=bar&baz=qux")))
      (Result.Success m) (Map.get &m "foo")
      _ @"")
    "form-data extracts key from POST body")

  (assert-equal test
    "qux"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"foo=bar&baz=qux")))
      (Result.Success m) (Map.get &m "baz")
      _ @"")
    "form-data extracts second key from POST body")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"msg=hello%20world")))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "form-data decodes percent-encoded values")

  (assert-true test
    (match (the (Result (Map String String) String)
                (Request.form-data &(Request.get (URI.zero) [] {} @"")))
      (Result.Success m) (= 0 (Map.length &m))
      _ false)
    "form-data on empty body returns empty map")

  (assert-equal test
    "name=carp"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "name" "carp")
      (Form.encode &m))
    "encode single pair")

  (assert-equal test
    "msg=hello+world"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "msg" "hello world")
      (Form.encode &m))
    "encode space as +")

  (assert-equal test
    "x=%26"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "x" "&")
      (Form.encode &m))
    "encode & as %26")

  (assert-equal test
    "k=a%2Bb"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "k" "a+b")
      (Form.encode &m))
    "encode literal + as %2B")

  (assert-equal test
    "key+name=val"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "key name" "val")
      (Form.encode &m))
    "encode space in key as +")

  (assert-true test
    (let-do [m (the (Map String String) {})]
      (Map.put! &m "a" "1")
      (match (the (Result (Map String String) String)
                  (Form.parse &(Form.encode &m)))
        (Result.Success parsed) (= &parsed &m)
        _ false))
    "encode/parse roundtrip single pair")

  (assert-equal test
    "k=%E2%82%AC"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "k" "€")
      (Form.encode &m))
    "encode a non-ASCII value one byte at a time")

  (assert-equal test
    "€"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "k" "€")
      (match (the (Result (Map String String) String)
                  (Form.parse &(Form.encode &m)))
        (Result.Success parsed) (Map.get &parsed "k")
        _ @""))
    "encode/parse roundtrip a non-ASCII value")

  (assert-equal test
    "b%4"
    &(match (the (Result (Map String String) String) (Form.parse "k=b%4"))
      (Result.Success m) (Map.get &m "k")
      _ @"")
    "parse a value ending in a truncated percent escape")

  (assert-equal test
    "b%"
    &(match (the (Result (Map String String) String) (Form.parse "k=b%"))
      (Result.Success m) (Map.get &m "k")
      _ @"")
    "parse a value ending in a bare percent")

  (assert-equal test
    2
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps) (Array.length &ps)
      _ 0)
    "parse-pairs returns correct count")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 0)) "name")
          (= (Pair.b (Array.unsafe-nth &ps 0)) "carp"))
      _ false)
    "parse-pairs first pair is correct")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 1)) "version")
          (= (Pair.b (Array.unsafe-nth &ps 1)) "1"))
      _ false)
    "parse-pairs second pair is correct")

  (assert-equal test
    3
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "x=1&x=2&x=3"))
      (Result.Success ps) (Array.length &ps)
      _ 0)
    "parse-pairs preserves duplicate keys")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "msg=hello+world"))
      (Result.Success ps) (= (Pair.b (Array.unsafe-nth &ps 0)) "hello world")
      _ false)
    "parse-pairs decodes + as space")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "flag"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 0)) "flag")
          (= (Pair.b (Array.unsafe-nth &ps 0)) ""))
      _ false)
    "parse-pairs handles key without value")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "x=%26%3D"))
      (Result.Success ps) (= (Pair.b (Array.unsafe-nth &ps 0)) "&=")
      _ false)
    "parse-pairs decodes percent-encoded values")

  (assert-equal test
    0
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs ""))
      (Result.Success ps) (Array.length &ps)
      _ -1)
    "parse-pairs on empty body returns empty array")
  ; ---- MediaType ----
  (assert-equal test
    "multipart/form-data"
    &(match (MediaType.parse "multipart/form-data; boundary=xyz")
      (Result.Success mt) (MediaType.mime &mt)
      (Result.Error _) @"ERR")
    "MediaType.parse extracts type/subtype")
  (assert-equal test
    "xyz"
    &(match (MediaType.parse "multipart/form-data; boundary=xyz")
      (Result.Success mt) (Maybe.from (MediaType.param &mt "boundary") @"?")
      (Result.Error _) @"ERR")
    "MediaType.parse extracts the boundary parameter")
  (assert-equal test
    "multipart/form-data"
    &(match (MediaType.parse "Multipart/Form-Data ; boundary=xyz")
      (Result.Success mt) (MediaType.mime &mt)
      (Result.Error _) @"ERR")
    "MediaType lowercases type/subtype and tolerates whitespace before ;")
  (assert-equal test
    "xyz"
    &(match (MediaType.parse "multipart/form-data; boundary=\"xyz\"")
      (Result.Success mt) (Maybe.from (MediaType.param &mt "boundary") @"?")
      (Result.Error _) @"ERR")
    "MediaType unquotes a quoted parameter value")
  (assert-equal test
    "xyz"
    &(match (MediaType.parse "multipart/form-data; BOUNDARY=xyz")
      (Result.Success mt) (Maybe.from (MediaType.param &mt "boundary") @"?")
      (Result.Error _) @"ERR")
    "MediaType parameter lookup is case-insensitive")
  (assert-true test
    (match (MediaType.parse "notamediatype")
      (Result.Error _) true
      (Result.Success _) false)
    "MediaType.parse errors without a subtype")
  (assert-equal test
    "a;b"
    &(let [ps (MediaType.parse-params "x/y; n=\"a;b\"")]
      (Maybe.from (Map.get-maybe &ps "n") @"?"))
    "parse-params keeps a semicolon inside a quoted value")

  ; ---- Multipart.parse ----
  (assert-equal test
    1
    (Array.length &(mp-parts &mp-text "b"))
    "one text part parses to one FormPart")
  (assert-equal test "a" &(mp-name &(mp-parts &mp-text "b") 0) "text part name")
  (assert-equal test
    "hello"
    &(mp-body &(mp-parts &mp-text "b") 0)
    "text part body")
  (assert-equal test
    "<none>"
    &(mp-fname &(mp-parts &mp-text "b") 0)
    "text part has no filename")
  (assert-equal test
    "up.txt"
    &(mp-fname &(mp-parts &mp-file "b") 0)
    "file part filename")
  (assert-equal test
    "text/plain"
    &(mp-ctype &(mp-parts &mp-file "b") 0)
    "file part content-type")
  (assert-equal test
    "data"
    &(mp-body &(mp-parts &mp-file "b") 0)
    "file part body")
  (assert-equal test
    2
    (Array.length &(mp-parts &mp-two "b"))
    "two parts parse to two FormParts")
  (assert-equal test
    "c"
    &(mp-name &(mp-parts &mp-two "b") 1)
    "second part name preserved in order")
  (assert-equal test
    "line1\r\nline2"
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline1\r\nline2\r\n--b--\r\n"
        "b")
      0)
    "CRLF inside a part body is preserved")
  (assert-equal test
    ""
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--b--\r\n"
        "b")
      0)
    "empty part body parses to the empty string")
  (assert-equal test
    "z"
    &(mp-name
      &(mp-parts
        "--b\r\ncontent-disposition: form-data; name=\"z\"\r\n\r\nq\r\n--b--\r\n"
        "b")
      0)
    "a lower-case Content-Disposition header is recognized")
  (assert-equal test
    "tail"
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\ntail\r\n--b--"
        "b")
      0)
    "a closing delimiter without a trailing CRLF still parses")
  (assert-equal test
    "ok"
    &(mp-body
      &(mp-parts
        "preamble\r\n--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nok\r\n--b--\r\n"
        "b")
      0)
    "a preamble before the first boundary is ignored")
  (assert-equal test
    "foo--bbar"
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nfoo--bbar\r\n--b--\r\n"
        "b")
      0)
    "a --boundary substring inside a body is not treated as a delimiter")
  (assert-equal test
    "a\"b"
    &(mp-name
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\\\"b\"\r\n\r\nv\r\n--b--\r\n"
        "b")
      0)
    "an escaped quote inside a quoted name is unescaped")
  (assert-equal test
    "v"
    &(mp-body
      &(mp-parts
        "------CarpBoundary9\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nv\r\n------CarpBoundary9--\r\n"
        "----CarpBoundary9")
      0)
    "a boundary with leading dashes round-trips")
  (assert-true test
    (match (Multipart.parse "no boundary here" "b")
      (Result.Error _) true
      (Result.Success _) false)
    "a missing boundary delimiter is an error")
  (assert-equal test
    &(continuation 64)
    &(mp-body
      &(mp-parts
        &(fmt
          "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n%s\r\n--b--\r\n"
          &(continuation 64))
        "b")
      0)
    "a part body that is not valid UTF-8 round-trips")
  (assert-equal test
    "ok"
    &(mp-body
      &(mp-parts
        &(fmt
          "%s\r\n--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nok\r\n--b--\r\n"
          &(continuation 64))
        "b")
      0)
    "a preamble that is not valid UTF-8 is ignored")
  (assert-equal test
    "888--LongBoundary8"
    &(mp-body
      &(mp-parts
        "--LongBoundary8\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n888--LongBoundary8\r\n--LongBoundary8--\r\n"
        "LongBoundary8")
      0)
    "a body repeating the delimiter’s last byte is scanned correctly")
  (assert-equal test
    "hello"
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello\r\n--b"
        "b")
      0)
    "a delimiter that ends at the end of the body is still found")

  ; ---- Request.multipart-data ----
  (assert-equal test
    "world"
    &(let [r (Request.post (URI.zero)
                           []
                           {@"Content-Type" [@"multipart/form-data; boundary=b"]}
                           @"--b\r\nContent-Disposition: form-data; name=\"greeting\"\r\n\r\nworld\r\n--b--\r\n")]
      (match (Request.multipart-data &r)
        (Result.Success ps) (mp-body &ps 0)
        (Result.Error _) @"ERR"))
    "Request.multipart-data decodes the body using the header boundary")
  (assert-true test
    (let [r (Request.post (URI.zero)
                          []
                          {@"Content-Type" [@"application/json"]}
                          @"{}")]
      (match (Request.multipart-data &r)
        (Result.Error _) true
        (Result.Success _) false))
    "Request.multipart-data errors on a non-multipart content type")
  (assert-true test
    (let [r (Request.post (URI.zero)
                          []
                          {@"Content-Type" [@"multipart/form-data"]}
                          @"--b--")]
      (match (Request.multipart-data &r)
        (Result.Error _) true
        (Result.Success _) false))
    "Request.multipart-data errors when the boundary parameter is absent")

  ; ---- content negotiation via the Accept header (RFC 7231 §5.3.2) ----
  (assert-equal test
    "text/html"
    &(pick "text/html" &[@"text/html"])
    "a range with no q defaults to weight 1")
  (assert-equal test
    "application/json"
    &(pick
      "text/html;q=0.8, application/json;q=0.9"
      &[@"text/html" @"application/json"])
    "the higher-weighted media type wins")
  (assert-equal test
    "image/png"
    &(pick "*/*;q=0.9, text/html;q=0.1" &[@"text/html" @"image/png"])
    "a specific range overrides */* for the type it names")
  (assert-equal test
    "image/png"
    &(pick "*/*, image/gif;q=0" &[@"image/gif" @"image/png"])
    "q=0 marks a type unacceptable even under */*")
  (assert-equal test
    "text/plain"
    &(pick "text/*" &[@"text/plain" @"application/json"])
    "a type/* range matches only that type")
  (assert-equal test
    "NONE"
    &(pick "application/json" &[@"text/html"])
    "no matching range means no acceptable offer")
  (assert-equal test
    "text/html"
    &(pick "" &[@"text/html" @"application/json"])
    "an empty Accept accepts anything and yields the first offer")
  (assert-equal test
    "application/json"
    &(pick "text/html, application/json" &[@"application/json" @"text/html"])
    "equal weights are broken by offer order")
  (assert-equal test
    "text/html"
    &(pick
      "  text/html ,  application/json ; q=0.9 "
      &[@"application/json" @"text/html"])
    "whitespace around ranges and parameters is tolerated")
  (assert-equal test
    "text/html"
    &(pick "text/html;q=bogus, image/png;q=0.5" &[@"text/html" @"image/png"])
    "an unparseable q falls back to weight 1")
  (assert-true test
    (= 3
       (Array.length
         &(Accept.parse "text/html, application/xml;q=0.9, */*;q=0.8")))
    "parse yields one entry per range")
  (assert-equal test
    "application/xml"
    &(range-mime "text/html, application/xml;q=0.9" 1)
    "a parsed range keeps its type and subtype")
  (assert-equal test
    "*/*"
    &(range-mime "text/html, */*;q=0.8" 1)
    "a wildcard range parses to */*")
  (assert-equal test
    "application/json"
    &(req-pick
      "text/html;q=0.5, application/json;q=0.9"
      &[@"text/html" @"application/json"])
    "Request.negotiate honors the request's Accept header")
  (assert-equal test
    "text/html"
    &(req-pick-noaccept &[@"text/html" @"application/json"])
    "Request.negotiate with no Accept header accepts anything")
  (assert-equal test
    "application/json"
    &(req-parse-pick &multi-header &[@"application/json"])
    "Request.negotiate folds an Accept split across multiple lines")
  (assert-equal test
    "text/html"
    &(req-parse-pick &multi-header &[@"text/html" @"application/json"])
    "Request.negotiate still honors the first line of a multi-line Accept")
  (assert-equal test
    "text/html"
    &(req-parse-pick
      "GET / HTTP/1.1\r\nHost: localhost\r\nAccept: text/html\r\n\r\n"
      &[@"text/html"])
    "Request.negotiate honors a single-line Accept")

  ; ---- content coding negotiation (Accept-Encoding, RFC 9110 §12.5.3) ----
  (assert-equal test
    "gzip"
    &(pick-enc "gzip" &[@"gzip"])
    "a coding with no q defaults to weight 1")
  (assert-equal test
    "br"
    &(pick-enc "gzip;q=0.5, br;q=0.9" &[@"gzip" @"br"])
    "the higher-weighted coding wins")
  (assert-equal test
    "NONE"
    &(pick-enc "gzip" &[@"br"])
    "a coding the field never names is unacceptable")
  (assert-equal test
    "NONE"
    &(pick-enc "gzip;q=0" &[@"gzip"])
    "q=0 makes a coding unacceptable, not least preferred")
  (assert-equal test
    "identity"
    &(pick-enc "gzip" &[@"identity"])
    "identity is acceptable by default when the field does not name it")
  (assert-equal test
    "NONE"
    &(pick-enc "identity;q=0" &[@"identity"])
    "identity;q=0 refuses identity")
  (assert-equal test
    "NONE"
    &(pick-enc "*;q=0" &[@"identity"])
    "*;q=0 refuses identity too")
  (assert-equal test
    "identity"
    &(pick-enc "*;q=0, identity;q=0.5" &[@"identity"])
    "an entry naming identity overrides a refusing *")
  (assert-equal test
    "br"
    &(pick-enc "*, gzip;q=0" &[@"gzip" @"br"])
    "* matches any coding not named elsewhere in the field")
  (assert-equal test
    "identity"
    &(pick-enc "" &[@"gzip" @"identity"])
    "an empty Accept-Encoding accepts only identity")
  (assert-equal test
    "NONE"
    &(pick-enc "" &[@"gzip"])
    "an empty Accept-Encoding refuses every other coding")
  (assert-equal test
    "GZip"
    &(pick-enc "GZIP" &[@"GZip"])
    "coding matching is case-insensitive")
  (assert-equal test
    "gzip@0.5"
    &(weighted-entry &(AcceptEncoding.parse "br, GZIP;q=0.5") 1)
    "parse lower-cases a coding and keeps its weight")
  (assert-equal test
    "gzip"
    &(req-pick-enc (the (Map String (Array String)) {}) &[@"gzip" @"identity"])
    "no Accept-Encoding header accepts anything")
  (assert-equal test
    "identity"
    &(req-pick-enc {@"Accept-Encoding" [@""]} &[@"gzip" @"identity"])
    "an Accept-Encoding header present but empty accepts only identity")
  (assert-equal test
    "br"
    &(req-pick-enc {@"Accept-Encoding" [@"br"]} &[@"gzip" @"br"])
    "Request.negotiate-encoding honors the request's Accept-Encoding header")

  ; ---- language negotiation (Accept-Language, RFC 4647 §3.3.1) ----
  (assert-equal test
    "en-US"
    &(pick-lang "en" &[@"en-US"])
    "a range matches a tag it prefixes on a subtag boundary")
  (assert-equal test
    "NONE"
    &(pick-lang "en-US" &[@"en"])
    "a range more specific than the tag does not match")
  (assert-equal test
    "NONE"
    &(pick-lang "en" &[@"eng"])
    "a prefix match must land on a subtag boundary")
  (assert-equal test "de" &(pick-lang "*" &[@"de"]) "* matches any tag")
  (assert-equal test
    "en-US"
    &(pick-lang "EN-us" &[@"en-US"])
    "language matching is case-insensitive")
  (assert-equal test
    "fr"
    &(pick-lang "de;q=0.5, fr;q=0.9" &[@"de" @"fr"])
    "the higher-weighted language wins")
  (assert-equal test
    "fr"
    &(pick-lang "de;q=0, *" &[@"de" @"fr"])
    "q=0 makes a language unacceptable even under *")
  (assert-equal test
    "fr"
    &(pick-lang "*, de;q=0.1" &[@"fr" @"de"])
    "a range naming a tag outweighs the * that also matches it")
  (assert-equal test
    "en-US"
    &(pick-lang "en, en-US" &[@"en-GB" @"en-US"])
    "the more specific range wins at equal weight")
  (assert-equal test
    "en-GB"
    &(pick-lang "en;q=0.9, en-US;q=0.1" &[@"en-GB" @"en-US"])
    "a tag takes the weight of the most specific range matching it")
  (assert-equal test
    "de"
    &(pick-lang "" &[@"de" @"en"])
    "an empty Accept-Language accepts anything and yields the first offer")
  (assert-equal test
    "NONE"
    &(pick-lang "de" &[@"fr"])
    "no matching range means no acceptable offer")
  (assert-equal test
    "en-us@0.5"
    &(weighted-entry &(AcceptLanguage.parse "de, EN-US;q=0.5") 1)
    "parse lower-cases a range and keeps its weight")
  (assert-equal test
    "de"
    &(req-pick-lang (the (Map String (Array String)) {}) &[@"de" @"en"])
    "no Accept-Language header accepts anything")
  (assert-equal test
    "fr"
    &(req-pick-lang {@"Accept-Language" [@"fr;q=0.9, de;q=0.1"]} &[@"de" @"fr"])
    "Request.negotiate-language honors the request's Accept-Language header")

  ; ---- byte ranges (Range/Content-Range, RFC 9110 §14) ----
  (assert-equal test
    "bytes=0-499"
    &(range-verdict "bytes=0-499")
    "a first-last spec parses and serializes back")
  (assert-equal test
    "bytes=500-"
    &(range-verdict "bytes=500-")
    "a from spec parses and serializes back")
  (assert-equal test
    "bytes=-500"
    &(range-verdict "bytes=-500")
    "a suffix spec parses and serializes back")
  (assert-equal test
    "bytes=0-499, 500-999"
    &(range-verdict "bytes=0-499,500-999")
    "a range-set holds several specs")
  (assert-equal test
    "bytes=0-0, -1"
    &(range-verdict "bytes=0-0, -1")
    "whitespace around a comma is ignored")
  (assert-equal test
    "bytes=0-1, 2-3"
    &(range-verdict "bytes=0-1,,2-3")
    "empty list elements are ignored")
  (assert-equal test
    "bytes=0-1"
    &(range-verdict "BYTES= 0-1 ")
    "the range unit is case-insensitive and the spec is trimmed")
  (assert-equal test
    "bytes=0-0"
    &(range-verdict "bytes=00-00")
    "leading zeroes in a bound are accepted")
  (assert-equal test
    "ERROR"
    &(range-verdict "items=0-1")
    "a range unit other than bytes is rejected")
  (assert-equal test
    "ERROR"
    &(range-verdict "bytes=")
    "an empty range-set is rejected")
  (assert-equal test
    "ERROR"
    &(range-verdict "bytes=,")
    "a range-set of only empty elements is rejected")
  (assert-equal test
    "ERROR"
    &(range-verdict "0-499")
    "a ranges-specifier without a unit is rejected")
  (assert-equal test
    "ERROR"
    &(range-verdict "bytes=abc")
    "a spec that is not digits is rejected")
  (assert-equal test
    "ERROR"
    &(range-verdict "bytes=-")
    "a spec with neither bound is rejected")
  (assert-equal test
    "ERROR"
    &(range-verdict "bytes=--1")
    "a spec with two dashes is rejected")
  (assert-equal test
    "ERROR"
    &(range-verdict "bytes=1-0")
    "a last-pos below its first-pos is rejected")
  (assert-equal test
    "ERROR"
    &(range-verdict "bytes=0-499,bad")
    "one invalid spec rejects the whole range-set")
  (assert-equal test
    Long.MAX
    (spec-bound "bytes=0-99999999999999999999999" 0)
    "a last-pos too large for a Long saturates")
  (assert-equal test
    Long.MAX
    (spec-bound "bytes=99999999999999999999999-" 0)
    "a first-pos too large for a Long saturates")
  (assert-equal test
    Long.MAX
    (spec-bound "bytes=-99999999999999999999999" 0)
    "a suffix-length too large for a Long saturates")
  (assert-equal test
    Long.MAX
    (spec-bound &(fmt "bytes=0-%s" &(repeated "9" 20000)) 0)
    "an absurd digit run saturates without crashing")
  (assert-equal test
    "0-499"
    &(resolved "bytes=0-499" 1234l)
    "a first-last spec inside the representation resolves as written")
  (assert-equal test
    "500-1233"
    &(resolved "bytes=500-" 1234l)
    "a from spec resolves to the end of the representation")
  (assert-equal test
    "734-1233"
    &(resolved "bytes=-500" 1234l)
    "a suffix spec resolves to the last bytes of the representation")
  (assert-equal test
    "0-1233"
    &(resolved "bytes=0-9999" 1234l)
    "a last-pos past the end clamps to the last byte")
  (assert-equal test
    "0-1233"
    &(resolved "bytes=-5000" 1234l)
    "a suffix-length past the length is the whole representation")
  (assert-equal test
    "1233-1233"
    &(resolved "bytes=1233-" 1234l)
    "a first-pos at the last byte resolves to one byte")
  (assert-equal test
    ""
    &(resolved "bytes=1234-" 1234l)
    "a first-pos at the end is unsatisfiable")
  (assert-equal test
    ""
    &(resolved "bytes=2000-3000" 1234l)
    "a spec past the end is unsatisfiable")
  (assert-equal test
    ""
    &(resolved "bytes=-0" 1234l)
    "a suffix-length of zero is unsatisfiable")
  (assert-equal test
    ""
    &(resolved "bytes=0-0" 0l)
    "no range is satisfiable in an empty representation")
  (assert-equal test
    "0-1"
    &(resolved "bytes=2000-,0-1" 1234l)
    "unsatisfiable specs are dropped from a range-set that has others")
  (assert-equal test
    "0-9,90-99"
    &(resolved "bytes=0-9,-10" 100l)
    "several satisfiable specs resolve in spec order")
  (assert-equal test
    "0-1233"
    &(resolved "bytes=0-99999999999999999999999" 1234l)
    "a saturated last-pos clamps to the last byte")
  (assert-equal test
    ""
    &(resolved "bytes=99999999999999999999999-" 1234l)
    "a saturated first-pos is unsatisfiable")
  (assert-equal test
    "0-1233"
    &(resolved "bytes=-99999999999999999999999" 1234l)
    "a saturated suffix-length is the whole representation")
  (assert-equal test
    "bytes=0-499, -200"
    &(ByteRange.str
      &[(ByteRangeSpec.FirstLast 0l 499l) (ByteRangeSpec.Suffix 200l)])
    "a client can build a Range header from specs")
  (assert-equal test
    "bytes 0-499/1234"
    &(content-range-verdict "bytes 0-499/1234")
    "a Content-Range parses and serializes back")
  (assert-equal test
    "bytes 0-499/*"
    &(content-range-verdict "bytes 0-499/*")
    "a Content-Range with an unknown complete length round-trips")
  (assert-equal test
    "bytes */1234"
    &(content-range-verdict "bytes */1234")
    "an unsatisfied Content-Range round-trips")
  (assert-equal test
    "bytes 0-1/2"
    &(content-range-verdict "BYTES 0-1/2")
    "the Content-Range unit is case-insensitive")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "bytes */*")
    "a Content-Range naming neither a range nor a length is rejected")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "items 0-1/2")
    "a Content-Range unit other than bytes is rejected")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "bytes 499-0/1234")
    "a Content-Range last-pos below its first-pos is rejected")
  (assert-equal test
    "bytes 0-1233/1234"
    &(content-range-verdict "bytes 0-1233/1234")
    "a Content-Range last-pos one below its complete length is valid")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "bytes 0-1234/1234")
    "a Content-Range complete length equal to its last-pos is rejected")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "bytes 1234-1234/1234")
    "a Content-Range naming the position past its complete length is rejected")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "bytes 5-9/3")
    "a Content-Range complete length below its last-pos is rejected")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "bytes 0-0/0")
    "a Content-Range naming a range of an empty representation is rejected")
  (assert-equal test
    "bytes 0-1234/*"
    &(content-range-verdict "bytes 0-1234/*")
    "an unknown complete length has no last-pos to contradict")
  (assert-equal test
    "bytes */0"
    &(content-range-verdict "bytes */0")
    "the unsatisfied form of an empty representation is valid")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "bytes 0-499")
    "a Content-Range without a complete length is rejected")
  (assert-equal test
    "ERROR"
    &(content-range-verdict "0-499/1234")
    "a Content-Range without a unit is rejected")
  (assert-true test
    (match (ContentRange.parse "bytes 0-499/1234")
      (Result.Success cr) (ContentRange.satisfied? &cr)
      (Result.Error _) false)
    "a Content-Range naming a range is satisfied")
  (assert-true test
    (match (ContentRange.parse "bytes */1234")
      (Result.Success cr) (not (ContentRange.satisfied? &cr))
      (Result.Error _) false)
    "the unsatisfied form of a Content-Range is not satisfied")
  (assert-equal test
    "bytes 0-499/1234"
    &(ContentRange.bytes 0l 499l 1234l)
    "ContentRange.bytes formats the header of a 206")
  (assert-equal test
    "bytes */1234"
    &(ContentRange.unsatisfied 1234l)
    "ContentRange.unsatisfied formats the header of a 416")
  (assert-equal test
    416
    Status.range-not-satisfiable
    "Status.range-not-satisfiable is 416")
  (assert-equal test
    "Range Not Satisfiable"
    &(Status.reason 416)
    "416 has a reason phrase")
  (assert-equal test
    "bytes=0-499"
    &(req-range-verdict {@"Range" [@"bytes=0-499"]})
    "Request.range parses the request's Range header")
  (assert-equal test
    "NONE"
    &(req-range-verdict {})
    "Request.range is Nothing without a Range header")
  (assert-equal test
    "ERROR"
    &(req-range-verdict {@"Range" [@"bytes=nonsense"]})
    "Request.range reports a Range header the server must ignore")
  (assert-equal test
    "malformed Range: 'nonsense'"
    &(range-error "nonsense")
    "a rejected range-set is reported against the wire header name")
  (assert-equal test
    "malformed Content-Range: 'nonsense'"
    &(content-range-error "nonsense")
    "a rejected Content-Range is reported against the wire header name")

  (assert-equal test
    "\"xyzzy\""
    &(etag-verdict "\"xyzzy\"")
    "a strong entity-tag round-trips")
  (assert-equal test
    "W/\"xyzzy\""
    &(etag-verdict "W/\"xyzzy\"")
    "a weak entity-tag round-trips")
  (assert-equal test
    "\"\""
    &(etag-verdict "\"\"")
    "an empty opaque-tag is a valid entity-tag")
  (assert-equal test
    "\"xyzzy\""
    &(etag-verdict "  \"xyzzy\"  ")
    "whitespace around an entity-tag is ignored")
  (assert-equal test
    "ERROR"
    &(etag-verdict "xyzzy")
    "an unquoted entity-tag is rejected")
  (assert-equal test
    "ERROR"
    &(etag-verdict "\"xyzzy")
    "an unterminated entity-tag is rejected")
  (assert-equal test
    "ERROR"
    &(etag-verdict "w/\"xyzzy\"")
    "the weak prefix is case-sensitive")
  (assert-equal test
    "ERROR"
    &(etag-verdict "\"xy zzy\"")
    "a space in an opaque-tag is rejected")
  (assert-equal test
    "ERROR"
    &(etag-verdict "\"")
    "a lone quote is not an empty entity-tag")
  (assert-equal test
    "ERROR"
    &(etag-verdict "\"a\"b\"")
    "a quote inside an opaque-tag is rejected")
  (assert-equal test
    "ERROR"
    &(etag-verdict
      &(String.append "\"a" &(String.append &(String.from-bytes &[127b]) "b\"")))
    "a DEL byte in an opaque-tag is rejected")
  (assert-true test
    (ETag.strong-match? &(ETag.init @"a" false) &(ETag.init @"a" false))
    "two strong entity-tags with the same value match strongly")
  (assert-false test
    (ETag.strong-match? &(ETag.init @"a" true) &(ETag.init @"a" true))
    "a weak entity-tag never matches strongly, not even itself")
  (assert-false test
    (ETag.strong-match? &(ETag.init @"a" false) &(ETag.init @"a" true))
    "a strong entity-tag does not strongly match its weak twin")
  (assert-true test
    (ETag.weak-match? &(ETag.init @"a" false) &(ETag.init @"a" true))
    "weak comparison ignores how either entity-tag is marked")
  (assert-false test
    (ETag.weak-match? &(ETag.init @"a" false) &(ETag.init @"b" false))
    "entity-tags with different values never match")
  (assert-equal test
    "*"
    &(tags-verdict "*")
    "a field value of * is the any-representation list")
  (assert-equal test
    "\"a\", W/\"b\""
    &(tags-verdict "\"a\", W/\"b\"")
    "a multi-element entity-tag list round-trips")
  (assert-equal test
    "\"a\", \"b\""
    &(tags-verdict "\"a\" , , \"b\"")
    "empty entity-tag list elements are ignored")
  (assert-equal test
    "\"a,b\""
    &(tags-verdict "\"a,b\"")
    "a comma inside an opaque-tag is not a list delimiter")
  (assert-equal test
    "ERROR"
    &(tags-verdict "")
    "an empty entity-tag list is rejected")
  (assert-equal test
    "ERROR"
    &(tags-verdict "\"a\", junk")
    "an entity-tag list with a malformed member is rejected")
  (assert-equal test
    "OK"
    &(precondition (no-headers)
                   "GET"
                   &(some-etag "a" false)
                   &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "a request with no conditional headers is answered normally")
  (assert-equal test
    "OK"
    &(precondition {@"If-Match" [@"\"a\""]}
                   "PUT"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-Match that matches lets the request through")
  (assert-equal test
    "412"
    &(precondition {@"If-Match" [@"\"b\""]}
                   "PUT"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-Match that does not match is a 412")
  (assert-equal test
    "OK"
    &(precondition {@"If-Match" [@"*"]} "PUT" &(no-etag) &(no-date))
    "an If-Match of * holds for a representation with no entity-tag")
  (assert-equal test
    "412"
    &(precondition {@"If-Match" [@"\"a\""]}
                   "PUT"
                   &(some-etag "a" true)
                   &(no-date))
    "If-Match compares strongly, so a weak entity-tag is a 412")
  (assert-equal test
    "412"
    &(precondition {@"If-Match" [@"\"a\""]} "PUT" &(no-etag) &(no-date))
    "an If-Match against a representation with no entity-tag is a 412")
  (assert-equal test
    "412"
    &(precondition {@"If-Match" [@"junk"]}
                   "PUT"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-Match the server cannot read fails closed with a 412")
  (assert-equal test
    "412"
    &(precondition
      {@"If-Unmodified-Since" [@"Sat, 05 Nov 1994 08:49:37 GMT"]}
      "PUT"
      &(no-etag)
      &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Unmodified-Since older than the representation is a 412")
  (assert-equal test
    "OK"
    &(precondition
      {@"If-Unmodified-Since" [@"Mon, 07 Nov 1994 08:49:37 GMT"]}
      "PUT"
      &(no-etag)
      &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Unmodified-Since newer than the representation lets it through")
  (assert-equal test
    "OK"
    &(precondition
      {@"If-Unmodified-Since" [@"Sat, 05 Nov 1994 08:49:37 GMT"]}
      "PUT"
      &(no-etag)
      &(no-date))
    "If-Unmodified-Since is ignored without a modification date")
  (assert-equal test
    "OK"
    &(precondition {@"If-Unmodified-Since" [@"not a date"]}
                   "PUT"
                   &(no-etag)
                   &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "If-Unmodified-Since is ignored when its value is not an HTTP-date")
  (assert-equal test
    "OK"
    &(precondition
      {@"If-Match" [@"\"a\""]
       @"If-Unmodified-Since" [@"Sat, 05 Nov 1994 08:49:37 GMT"]}
      "PUT"
      &(some-etag "a" false)
      &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "If-Unmodified-Since is evaluated only when If-Match is absent")
  (assert-equal test
    "304"
    &(precondition {@"If-None-Match" [@"\"a\""]}
                   "GET"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-None-Match that matches is a 304 for a GET")
  (assert-equal test
    "304"
    &(precondition {@"If-None-Match" [@"\"a\""]}
                   "HEAD"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-None-Match that matches is a 304 for a HEAD")
  (assert-equal test
    "412"
    &(precondition {@"If-None-Match" [@"\"a\""]}
                   "PUT"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-None-Match that matches is a 412 for anything but a GET or HEAD")
  (assert-equal test
    "304"
    &(precondition {@"If-None-Match" [@"\"a\""]}
                   "GET"
                   &(some-etag "a" true)
                   &(no-date))
    "If-None-Match compares weakly, so a weak entity-tag still matches")
  (assert-equal test
    "OK"
    &(precondition {@"If-None-Match" [@"\"b\""]}
                   "GET"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-None-Match that does not match lets the request through")
  (assert-equal test
    "304"
    &(precondition {@"If-None-Match" [@"*"]}
                   "GET"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-None-Match of * matches any current representation")
  (assert-equal test
    "304"
    &(precondition {@"If-None-Match" [@"\"x\", W/\"a\""]}
                   "GET"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-None-Match matches on any member of its list")
  (assert-equal test
    "304"
    &(precondition {@"If-None-Match" [@"\"x\"" @"\"a\""]}
                   "GET"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-None-Match split across header lines is read as one list")
  (assert-equal test
    "OK"
    &(precondition {@"If-None-Match" [@"junk"]}
                   "GET"
                   &(some-etag "a" false)
                   &(no-date))
    "an If-None-Match the server cannot read is ignored")
  (assert-equal test
    "412"
    &(precondition
      {@"If-Match" [@"\"b\""]
       @"If-None-Match" [@"\"a\""]}
      "GET"
      &(some-etag "a" false)
      &(no-date))
    "a failed If-Match wins over an If-None-Match that would be a 304")
  (assert-equal test
    "304"
    &(precondition
      {@"If-Modified-Since" [@"Sun, 06 Nov 1994 08:49:37 GMT"]}
      "GET"
      &(no-etag)
      &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Modified-Since equal to the modification date is a 304")
  (assert-equal test
    "OK"
    &(precondition
      {@"If-Modified-Since" [@"Sat, 05 Nov 1994 08:49:37 GMT"]}
      "GET"
      &(no-etag)
      &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Modified-Since older than the modification date sends the body")
  (assert-equal test
    "OK"
    &(precondition
      {@"If-Modified-Since" [@"Sun, 06 Nov 1994 08:49:37 GMT"]}
      "POST"
      &(no-etag)
      &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "If-Modified-Since is ignored for a method that is not GET or HEAD")
  (assert-equal test
    "OK"
    &(precondition
      {@"If-Modified-Since" [@"Sun, 06 Nov 1994 08:49:37 GMT"]}
      "GET"
      &(no-etag)
      &(no-date))
    "If-Modified-Since is ignored without a modification date")
  (assert-equal test
    "OK"
    &(precondition
      {@"If-None-Match" [@"\"b\""]
       @"If-Modified-Since" [@"Sun, 06 Nov 1994 08:49:37 GMT"]}
      "GET"
      &(some-etag "a" false)
      &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "If-Modified-Since is evaluated only when If-None-Match is absent")
  (assert-equal test
    "304"
    &(req-precondition {@"If-None-Match" [@"\"a\""]}
                       "GET"
                       &(some-etag "a" false)
                       &(no-date))
    "Request.preconditions evaluates the request's own headers and method")
  (assert-equal test
    "412"
    &(req-precondition {@"If-None-Match" [@"\"a\""]}
                       "PUT"
                       &(some-etag "a" false)
                       &(no-date))
    "Request.preconditions answers a non-GET If-None-Match with a 412")
  (assert-equal test
    "OK"
    &(req-precondition
      {@"If-Modified-Since" [@"Sun, 06 Nov 1994 08:49:37 GMT"]}
      "POST"
      &(no-etag)
      &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "Request.preconditions gates If-Modified-Since on the request's own method")
  (assert-true test
    (if-range? "\"a\"" &(some-etag "a" false) &(no-date))
    "an If-Range entity-tag matching the representation honors the Range")
  (assert-false test
    (if-range? "\"b\"" &(some-etag "a" false) &(no-date))
    "an If-Range entity-tag naming another version ignores the Range")
  (assert-false test
    (if-range? "W/\"a\"" &(some-etag "a" false) &(no-date))
    "an If-Range compares strongly, so a weak entity-tag never matches")
  (assert-false test
    (if-range? "\"a\"" &(some-etag "a" true) &(no-date))
    "an If-Range against a weakly validated representation never matches")
  (assert-false test
    (if-range? "\"a\"" &(no-etag) &(no-date))
    "an If-Range entity-tag against a representation with none is a non-match")
  (assert-false test
    (if-range? "junk" &(some-etag "a" false) &(no-date))
    "an If-Range that reads as neither validator form is a non-match")
  (assert-true test
    (if-range? "Sun, 06 Nov 1994 08:49:37 GMT"
               &(no-etag)
               &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Range date equal to the modification date honors the Range")
  (assert-false test
    (if-range? "Sun, 06 Nov 1994 08:49:36 GMT"
               &(no-etag)
               &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Range date a second before the modification date is a non-match")
  (assert-false test
    (if-range? "Sun, 06 Nov 1994 08:49:38 GMT"
               &(no-etag)
               &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Range date a second after the modification date is a non-match")
  (assert-true test
    (if-range? "Sunday, 06-Nov-94 08:49:37 GMT"
               &(no-etag)
               &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Range date names an instant, whichever HTTP-date format spells it")
  (assert-false test
    (if-range? "not a date" &(no-etag) &(at "Sun, 06 Nov 1994 08:49:37 GMT"))
    "an If-Range date the server cannot read is a non-match")
  (assert-false test
    (if-range? "Sun, 06 Nov 1994 08:49:37 GMT" &(some-etag "a" false) &(no-date))
    "an If-Range date against a representation with none is a non-match")
  (assert-true test
    (Precondition.if-range-matches? &{@"Range" [@"bytes=0-499"]}
                                    &(some-etag "a" false)
                                    &(no-date))
    "a Range with no If-Range is honored")
  (assert-true test
    (Precondition.if-range-matches? &{@"If-Range" [@"\"b\""]}
                                    &(some-etag "a" false)
                                    &(no-date))
    "an If-Range without a Range to gate is ignored")
  (assert-true test
    (Precondition.if-range-matches? &(no-headers) &(no-etag) &(no-date))
    "a request with neither header is honored")
  (assert-false test
    (Request.if-range-matches?
      &(Request.get (URI.zero)
                    []
                    {@"Range" [@"bytes=0-499"]
                     @"If-Range" [@"\"b\""]}
                    @"")
      &(some-etag "a" false)
      &(no-date))
    "Request.if-range-matches? evaluates the request's own headers")
  (assert-equal test
    412
    Status.precondition-failed
    "Status.precondition-failed is 412")
  (assert-equal test
    "Precondition Failed"
    &(Status.reason 412)
    "412 has a reason phrase")

  (assert-equal test
    &(dechunk-ok "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")
    "Wikipedia"
    "dechunk decodes a multi-chunk body")

  (assert-equal test
    &(dechunk-ok "1c\r\nabcdefghijklmnopqrstuvwxyz01\r\n0\r\n\r\n")
    "abcdefghijklmnopqrstuvwxyz01"
    "dechunk decodes a chunk with a multi-digit hex size")

  (assert-equal test
    &(dechunk-ok "4;name=value\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")
    "Wikipedia"
    "dechunk ignores chunk extensions")

  (assert-equal test
    &(dechunk-ok "0\r\n\r\n")
    ""
    "dechunk decodes a zero-only body")

  (assert-equal test
    &(dechunk-ok "5\r\nhello\r\n0\r\nX-Checksum: abc123\r\nX-Extra: 1\r\n\r\n")
    "hello"
    "dechunk ignores trailing headers")

  (assert-true test
    (dechunk-err? "zz\r\nWiki\r\n0\r\n\r\n")
    "dechunk errors on a non-hex chunk size")

  (assert-true test
    (dechunk-err? "80000000\r\nWiki\r\n0\r\n\r\n")
    "dechunk rejects an overflowing chunk size instead of segfaulting")

  (assert-true test
    (dechunk-err? "100000000\r\nWiki\r\n0\r\n\r\n")
    "dechunk rejects a 2^32 chunk size instead of silently mis-decoding as empty")

  (assert-true test
    (dechunk-err? "5\r\nhi\r\n0\r\n\r\n")
    "dechunk errors on a chunk shorter than its declared size")

  (assert-true test
    (dechunk-err? "4\r\nWiki\r\n5\r\npedia\r\n")
    "dechunk errors on a missing terminating zero-size chunk")

  (assert-true test
    (dechunk-err? " 5\r\nhello\r\n0\r\n\r\n")
    "dechunk rejects a chunk size line with leading whitespace")

  (assert-true test
    (dechunk-err? "\t5\r\nhello\r\n0\r\n\r\n")
    "dechunk rejects a chunk size line starting with a tab")

  (assert-true test
    (dechunk-err? "5 \r\nhello\r\n0\r\n\r\n")
    "dechunk rejects a chunk size with trailing whitespace and no extension")

  (assert-true test
    (dechunk-err? "5\r\r\nhello\r\n0\r\n\r\n")
    "dechunk rejects a stray CR between the chunk size and the CRLF")

  (assert-true test
    (dechunk-err? " 0 \r\n\r\n")
    "dechunk rejects a whitespace-padded terminating chunk")

  (assert-true test
    (dechunk-err? ";name=value\r\nhello\r\n0\r\n\r\n")
    "dechunk rejects a chunk extension with no size before it")

  (assert-equal test
    &(dechunk-ok "5 ;name=value\r\nhello\r\n0\r\n\r\n")
    "hello"
    "dechunk allows the bad whitespace RFC 9112 §7.1.1 permits before an extension")

  (assert-equal test
    &(dechunk-ok "1C\r\nabcdefghijklmnopqrstuvwxyz01\r\n0\r\n\r\n")
    "abcdefghijklmnopqrstuvwxyz01"
    "dechunk decodes an uppercase hex chunk size")

  (assert-equal test
    &(match (Response.parse
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")
      (Result.Success r)
        (if (Response.chunked? &r)
          (dechunk-ok (Response.body &r))
          @"not-chunked")
      _ @"parse-failed")
    "Wikipedia"
    "parse + chunked? + dechunk decodes a real chunked response")

  (assert-true test
    (resp-chunked? "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n")
    "chunked? true for Transfer-Encoding: chunked")

  (assert-true test
    (resp-chunked? "HTTP/1.1 200 OK\r\ntransfer-encoding: Chunked\r\n\r\n")
    "chunked? is case-insensitive in header name and value")

  (assert-true test
    (resp-chunked? "HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n")
    "chunked? true when chunked is last in a coding list")

  (assert-false test
    (resp-chunked? "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
    "chunked? false when Transfer-Encoding header is absent")

  (assert-false test
    (resp-chunked? "HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\n\r\n")
    "chunked? false when chunked is not among the codings")

  (assert-true test
    (req-chunked? "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n")
    "Request.chunked? true for Transfer-Encoding: chunked")

  (assert-true test
    (req-chunked?
      "POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n")
    "Request.chunked? true when chunked is on a second Transfer-Encoding line")

  (assert-true test
    (req-chunked?
      "POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\ntransfer-encoding: chunked\r\n\r\n")
    "Request.chunked? folds Transfer-Encoding lines that differ only in case")

  (assert-false test
    (req-chunked?
      "POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: deflate\r\n\r\n")
    "Request.chunked? false when no Transfer-Encoding line lists chunked")

  ; ---- Cache-Control ----
  (assert-equal test
    3600
    (let [m (CacheControl.parse "max-age=3600, no-cache")]
      (Maybe.from (CacheControl.max-age &m) -1))
    "CacheControl.max-age is parsed as an Int")
  (assert-true test
    (let [m (CacheControl.parse "max-age=3600, no-cache")]
      (CacheControl.no-cache? &m))
    "CacheControl detects no-cache alongside a valued directive")
  (assert-true test
    (let [m (CacheControl.parse "no-store")] (CacheControl.no-store? &m))
    "CacheControl detects a lone valueless directive")
  (assert-true test
    (let [m (CacheControl.parse "no-store")]
      (match (CacheControl.max-age &m) (Maybe.Nothing) true (Maybe.Just _) false))
    "CacheControl.max-age is Nothing when the directive is absent")
  (assert-true test
    (let [m (CacheControl.parse "private, max-age=0")]
      (CacheControl.private? &m))
    "CacheControl detects private")
  (assert-equal test
    0
    (let [m (CacheControl.parse "private, max-age=0")]
      (Maybe.from (CacheControl.max-age &m) -1))
    "CacheControl parses max-age=0")
  (assert-equal test
    60
    (let [m (CacheControl.parse "Max-Age=60")]
      (Maybe.from (CacheControl.max-age &m) -1))
    "CacheControl directive names are case-insensitive")
  (assert-equal test
    120
    (let [m (CacheControl.parse "public, s-maxage=120")]
      (Maybe.from (CacheControl.s-maxage &m) -1))
    "CacheControl.s-maxage is parsed as an Int")
  (assert-equal test
    2
    (Map.length &(CacheControl.parse "no-cache=\"Set-Cookie, X\", max-age=5"))
    "CacheControl keeps a comma inside a quoted value as one directive")
  (assert-equal test
    "Set-Cookie, X"
    &(let [m (CacheControl.parse "no-cache=\"Set-Cookie, X\"")]
      (Maybe.from (CacheControl.directive &m "no-cache") @"?"))
    "CacheControl unquotes a quoted directive value")
  (assert-equal test
    0
    (Map.length &(CacheControl.parse ""))
    "CacheControl parses an empty header into an empty map")
  (assert-equal test
    "5\r\nhello\r\n0\r\n\r\n"
    &(TransferEncoding.chunk "hello")
    "chunk emits a hex size line, the data, and the terminator")
  (assert-equal test
    "0\r\n\r\n"
    &(TransferEncoding.chunk "")
    "chunk of an empty body is just the terminator")
  (assert-equal test
    "2\r\nhe\r\n2\r\nll\r\n1\r\no\r\n0\r\n\r\n"
    &(TransferEncoding.chunk-with-size "hello" 2)
    "chunk-with-size splits the body into size-bounded chunks")
  (assert-true test
    (chunk-rt? "hello world" 1)
    "chunk-with-size round-trips through dechunk at size 1")
  (assert-true test
    (chunk-rt? "hello world" 4)
    "chunk-with-size round-trips through dechunk at size 4")
  (assert-true test
    (chunk-rt? &(String.repeat 300 "x") 256)
    "chunk-with-size round-trips across the two-to-three hex-digit boundary")
  (assert-true test
    (chunk-rt? "héllo wörld" 3)
    "chunk-with-size is byte-exact across multi-byte UTF-8 split points")
  (assert-true test
    (chunk-rt? "abc" 0)
    "chunk-with-size clamps a non-positive size to at least 1")
  (assert-true test
    (match (TransferEncoding.dechunk
        &(TransferEncoding.chunk "the quick brown fox"))
      (Result.Success b) (= &b "the quick brown fox")
      (Result.Error _) false)
    "chunk (single chunk) round-trips through dechunk")
  (assert-equal test
    200
    @(Response.code &(Response.ok {} @"hi"))
    "Response.ok sets code 200")
  (assert-equal test
    "OK"
    (Response.message &(Response.ok {} @"hi"))
    "Response.ok sets the reason phrase as the message")
  (assert-equal test
    "5"
    &(Maybe.from
      (Response.header &(Response.ok {} @"hello") "Content-Length")
      @"")
    "respond sets Content-Length to the body byte length")
  (assert-equal test
    "6"
    &(Maybe.from
      (Response.header &(Response.ok {} @"héllo") "Content-Length")
      @"")
    "respond Content-Length counts bytes, not codepoints")
  (assert-equal test
    201
    @(Response.code &(Response.created {} @"{}"))
    "Response.created sets code 201")
  (assert-equal test
    "No Content"
    (Response.message &(Response.no-content {}))
    "Response.no-content sets the 204 reason phrase")
  (assert-equal test
    0
    (String.length (Response.body &(Response.no-content {})))
    "Response.no-content has an empty body")
  (assert-equal test
    false
    (Maybe.just? &(Response.header &(Response.no-content {}) "Content-Length"))
    "Response.no-content omits Content-Length per RFC 7230")
  (assert-equal test
    "application/json"
    &(Maybe.from
      (Response.header
        &(Response.with-content-type (Response.ok {} @"{}") @"application/json")
        "Content-Type")
      @"")
    "with-content-type sets the Content-Type header")
  (assert-equal test
    "application/json"
    &(Maybe.from
      (Response.header
        &(Response.with-content-type
          (Response.with-content-type (Response.ok {} @"{}") @"text/plain")
          @"application/json")
        "Content-Type")
      @"")
    "with-content-type replaces an existing Content-Type")
  (assert-equal test
    1
    (Array.length
      &(Array.copy-filter
        &(fn [l] (String.starts-with? l "Content-Type:"))
        &(String.split-by
          &(Response.str
            &(Response.with-content-type
              (Response.with-content-type (Response.ok {} @"{}") @"text/plain")
              @"application/json"))
          &[\newline])))
    "with-content-type emits exactly one Content-Type line")
  (assert-equal test
    "/new"
    &(Maybe.from
      (Response.header
        &(Response.redirect Status.found @"/new" {@"Location" [@"/old"]})
        "Location")
      @"")
    "redirect replaces a Location in the given headers")
  (assert-equal test
    "1"
    &(Maybe.from
      (Response.header
        &(Response.with-header (Response.ok {} @"x") @"X-Test" @"1")
        "X-Test")
      @"")
    "with-header adds a header value")
  (assert-equal test
    1
    (match (Cookie.parse "a=b")
      (Result.Success c)
        (Array.length
          (Response.cookies &(Response.with-cookie (Response.ok {} @"x") c)))
      (Result.Error _) -1)
    "with-cookie appends a cookie")
  (assert-equal test
    302
    @(Response.code &(Response.redirect Status.found @"/new" {}))
    "redirect sets the status code")
  (assert-equal test
    "/new"
    &(Maybe.from
      (Response.header &(Response.redirect Status.found @"/new" {}) "Location")
      @"")
    "redirect sets the Location header")
  (assert-equal test
    "Partial Content"
    &(Status.reason 206)
    "Status.reason knows 206")
  (assert-equal test
    "Gateway Timeout"
    &(Status.reason 504)
    "Status.reason knows 504")
  (assert-true test
    (match (Response.parse &(Response.str &(Response.ok {} @"hello")))
      (Result.Success r)
        (and (= 200 @(Response.code &r)) (= "hello" (Response.body &r)))
      (Result.Error _) false)
    "a built response round-trips through parse")

  ; ---- cookie expiry ----
  (assert-equal test
    "expired"
    &(expiry-verdict "id=abc; Max-Age=0; Expires=Thu, 01 Jan 2037 00:00:00 GMT")
    "Max-Age wins over an Expires that comes after it")
  (assert-equal test
    "expired"
    &(expiry-verdict "id=abc; Expires=Thu, 01 Jan 2037 00:00:00 GMT; Max-Age=0")
    "Max-Age wins over an Expires that comes before it")
  (assert-equal test
    "expired"
    &(expiry-verdict "id=abc; Max-Age=0")
    "Max-Age=0 expires the cookie immediately")
  (assert-equal test
    "expired"
    &(expiry-verdict-at "id=abc; Max-Age=0" &(zoned 2021 6 9 12 @"UTC" 0l))
    "Max-Age=0 puts the expiry in the past, not at the instant of parsing")
  (assert-equal test
    "expired"
    &(expiry-verdict "id=abc; Max-Age=-100")
    "a negative Max-Age expires the cookie immediately")
  (assert-equal test
    "live"
    &(expiry-verdict "id=abc; Max-Age=3600")
    "a positive Max-Age keeps the cookie alive")
  (assert-equal test
    "expired"
    &(expiry-verdict "id=abc; Expires=Wed, 09 Jun 2021 10:18:14 GMT")
    "a past Expires expires the cookie when there is no Max-Age")
  (assert-equal test
    "live"
    &(expiry-verdict "id=abc; Expires=Thu, 01 Jan 2037 00:00:00 GMT")
    "a future Expires keeps the cookie alive when there is no Max-Age")
  (assert-equal test
    "live"
    &(expiry-verdict "id=abc; Expires=Wed, 01 Jan 2070 00:00:00 GMT")
    "an Expires past 2038 stays live and does not wrap the epoch")
  (assert-equal test
    "live"
    &(expiry-verdict "id=abc; Expires=Fri, 31 Dec 9999 23:59:59 GMT")
    "the never-expires idiom (Expires 9999) stays live")
  (assert-equal test
    "live"
    &(expiry-verdict-at
      "id=abc; Expires=Fri, 24 Jul 2026 12:00:00 GMT"
      &(zoned 2026 7 24 13 @"CEST" 7200l))
    "13:00 at UTC+2 is 11:00 GMT, before a 12:00 GMT expiry")
  (assert-equal test
    "expired"
    &(expiry-verdict-at
      "id=abc; Expires=Fri, 24 Jul 2026 12:00:00 GMT"
      &(zoned 2026 7 24 11 @"EST" -18000l))
    "11:00 at UTC-5 is 16:00 GMT, after a 12:00 GMT expiry")
  (assert-equal test
    "Basic dXNlcjpwYXNz"
    &(chal-summary "Basic dXNlcjpwYXNz")
    "a bare token after a scheme parses as token68")
  (assert-equal test
    "Basic dXNlcjpwYXNz=="
    &(chal-summary "Basic dXNlcjpwYXNz==")
    "token68 keeps its trailing padding")
  (assert-equal test
    "Basic dTphYWE/"
    &(chal-summary "Basic dTphYWE/")
    "a token68 keeps a slash, which the token grammar excludes")
  (assert-equal test
    "Digest/realm=a|b"
    &(chal-summary "Digest realm=a/b")
    "the wider token68 alphabet does not reach an auth-param value")
  (assert-equal test
    "Digest/realm=a/qop=auth"
    &(chal-summary "Digest realm=\"a\", qop=\"auth\"")
    "commas between auth-params stay inside one challenge")
  (assert-equal test
    "Digest/algorithm=MD5/nc=1"
    &(chal-summary "Digest algorithm=MD5, nc=1")
    "auth-param values may be bare tokens")
  (assert-equal test
    "Digest/qop=auth,auth-int"
    &(chal-summary "Digest qop=\"auth,auth-int\"")
    "a comma inside a quoted-string does not split the list")
  (assert-equal test
    "Newauth/realm=apps/type=1/title=Login to \"apps\"|Basic/realm=simple"
    &(chal-summary
      "Newauth realm=\"apps\", type=1, title=\"Login to \\\"apps\\\"\", Basic realm=\"simple\"")
    "the RFC 7235 §4.1 example splits into two challenges")
  (assert-equal test
    "Basic/realm=a|Bearer|Digest/realm=b"
    &(chal-summary "Basic realm=\"a\", Bearer, Digest realm=\"b\"")
    "a challenge with no params survives between two that have them")
  (assert-equal test
    3
    (chal-count "Basic realm=\"a\", Bearer, Digest realm=\"b\"")
    "three challenges are found where the middle one is bare")
  (assert-equal test
    "Digest/realm=say \"hi\"/nonce=a\\b"
    &(chal-summary "Digest realm=\"say \\\"hi\\\"\", nonce=\"a\\\\b\"")
    "backslash escapes resolve inside quoted-strings")
  (assert-equal test
    "WallyWorld"
    &(chal-realm "Basic realm=\"WallyWorld\"" 0)
    "realm reads the realm auth-param")
  (assert-equal test
    "x"
    &(chal-realm "Basic REALM=\"x\"" 0)
    "auth-param names are matched case-insensitively")
  (assert-equal test
    "<none>"
    &(chal-realm "Bearer" 0)
    "realm is Nothing for a challenge without one")
  (assert-equal test
    "BASIC dXNlcjpwYXNz"
    &(chal-summary "BASIC dXNlcjpwYXNz")
    "the scheme is preserved exactly as written")
  (assert-true test
    (auth-scheme-is? "BaSiC dXNlcjpwYXNz" "basic")
    "scheme matching is case-insensitive")
  (assert-false test
    (auth-scheme-is? "Bearer abc" "basic")
    "scheme matching rejects a different scheme")
  (assert-equal test
    "Basic realm=\"WallyWorld\""
    &(auth-roundtrip "Basic realm=\"WallyWorld\"")
    "a challenge round-trips through the serializer")
  (assert-equal test
    "Basic dXNlcjpwYXNz=="
    &(auth-roundtrip "Basic dXNlcjpwYXNz==")
    "token68 round-trips through the serializer")
  (assert-equal test
    "Basic realm=\"a\", Bearer, Digest realm=\"b\""
    &(auth-roundtrip "Basic realm=\"a\", Bearer, Digest realm=\"b\"")
    "a challenge list round-trips, bare challenge included")
  (assert-equal test
    "Digest realm=\"say \\\"hi\\\"\""
    &(auth-roundtrip "Digest realm=\"say \\\"hi\\\"\"")
    "quotes in a param value are re-escaped on serialization")
  (assert-equal test
    "Digest algorithm=\"MD5\""
    &(auth-roundtrip "Digest algorithm=MD5")
    "an unquoted param value is quoted on serialization")
  (assert-equal test
    "Basic dXNlcjpwYXNz"
    &(basic-header "user" "pass")
    "Auth.basic base64-encodes user and password")
  (assert-equal test
    "user/pass"
    &(basic-header-roundtrip "user" "pass")
    "Basic credentials round-trip through parse and decode")
  (assert-equal test
    "Basic dTphYWE/"
    &(basic-header "u" "aaa?")
    "Auth.basic emits the standard base64 alphabet, slash included")
  (assert-equal test
    "u/aaa?"
    &(basic-header-roundtrip "u" "aaa?")
    "Basic credentials whose base64 contains a slash round-trip")
  (assert-equal test
    "user/pa:ss:word"
    &(basic-header-roundtrip "user" "pa:ss:word")
    "a password may contain colons, which stay in the password")
  (assert-equal test
    "user/"
    &(basic-header-roundtrip "user" "")
    "an empty password round-trips")
  (assert-equal test
    "a Basic user-id may not contain a colon"
    &(basic-header "us:er" "pass")
    "Auth.basic rejects a user-id containing a colon")
  (assert-equal test
    "Basic credentials have no colon"
    &(basic-parts "Basic aaaa")
    "base64 that decodes without a colon is a clean failure")
  (assert-equal test
    "Basic credentials have no colon"
    &(basic-parts "Basic")
    "a lone Basic scheme is a clean failure")
  (assert-equal test
    "input length must be a multiple of 4"
    &(basic-parts "Basic !!!")
    "invalid base64 is a clean failure")
  (assert-equal test
    "not Basic credentials: 'Bearer'"
    &(basic-parts "Bearer abc")
    "basic-credentials rejects another scheme")
  (assert-equal test
    "Bearer abc123"
    &(Auth.bearer "abc123")
    "Auth.bearer builds a Bearer header value")
  (assert-equal test
    "abc123"
    &(bearer-of "Bearer abc123")
    "bearer-token reads the token back")
  (assert-equal test
    "abc123"
    &(bearer-of "bearer abc123")
    "bearer-token accepts a lower-cased scheme")
  (assert-equal test
    "ab/cd.ef/gh"
    &(bearer-of "Bearer ab/cd.ef/gh")
    "a Bearer token may contain slashes")
  (assert-equal test
    1
    (chal-count "Bearer ab/cd.ef/gh")
    "a slash does not split a Bearer token into two challenges")
  (assert-equal test
    "/abc"
    &(bearer-of "Bearer /abc")
    "a token68 may begin with a slash")
  (assert-equal test
    "empty Bearer token"
    &(bearer-of "Bearer")
    "bearer-token rejects a scheme with no token")
  (assert-equal test
    "not Bearer credentials: 'Basic'"
    &(bearer-of "Basic dXNlcjpwYXNz")
    "bearer-token rejects another scheme")
  (assert-equal test
    "Basic realm=\"WallyWorld\""
    &(Auth.basic-challenge "WallyWorld")
    "basic-challenge builds a WWW-Authenticate value")
  (assert-equal test
    "Basic realm=\"say \\\"hi\\\"\""
    &(Auth.basic-challenge "say \"hi\"")
    "basic-challenge escapes quotes in the realm")
  (assert-equal test
    "Bearer realm=\"api\""
    &(Auth.bearer-challenge "api")
    "bearer-challenge builds a WWW-Authenticate value")
  (assert-equal test
    "malformed credentials: ''"
    &(auth-verdict "")
    "Auth.parse rejects an empty value")
  (assert-equal test
    "malformed credentials: '   '"
    &(auth-verdict "   ")
    "Auth.parse rejects a whitespace-only value")
  (assert-equal test
    "more than one scheme in credentials: 'Basic abc, Bearer def'"
    &(auth-verdict "Basic abc, Bearer def")
    "Auth.parse rejects more than one scheme")
  (assert-equal test
    "<ok>"
    &(auth-verdict "Basic")
    "Auth.parse accepts a scheme with no credentials")
  (assert-equal test
    0
    (chal-count "")
    "an empty header value yields no challenges")
  (assert-equal test
    0
    (chal-count " \t ")
    "a whitespace-only header value yields no challenges")
  (assert-equal test 0 (chal-count ",,,") "commas alone yield no challenges")
  (assert-equal test
    0
    (chal-count "=")
    "a stray equals sign yields no challenges")
  (assert-equal test
    "Basic"
    &(chal-summary "Basic ,")
    "a trailing comma does not invent a challenge")
  (assert-equal test
    "Basic/realm=unterminated"
    &(chal-summary "Basic realm=\"unterminated")
    "an unterminated quoted-string runs to the end of the value")
  (assert-equal test
    "Basic/realm=a\\"
    &(chal-summary "Basic realm=\"a\\")
    "a trailing backslash inside a quoted-string is kept literally")
  (assert-equal test
    "Basic/realm=/foo="
    &(chal-summary "Basic realm=\"\", foo=")
    "empty param values parse as empty")
  (assert-equal test
    "Basic"
    &(chal-summary "Basic éé")
    "non-ASCII bytes outside a quoted-string are dropped")
  (assert-equal test
    "Basic/realm=é"
    &(chal-summary "Basic realm=\"é\"")
    "non-ASCII bytes inside a quoted-string are preserved")
  (assert-equal test
    1
    (chal-count &(fmt "Basic realm=\"%s\"" &(repeated "a" 20000)))
    "a very long header value parses without crashing")
  (assert-equal test
    0
    (chal-count &(repeated "\\\"=," 5000))
    "a long run of delimiters parses without crashing")
  (assert-equal test
    401
    @(Response.code
      &(Response.unauthorized (Auth.basic-challenge "site") {} @""))
    "Response.unauthorized is a 401")
  (assert-equal test
    "Basic realm=\"site\""
    &(unauthorized-header (Auth.basic-challenge "site") {})
    "Response.unauthorized attaches the challenge")
  (assert-equal test
    "Basic realm=\"new\""
    &(unauthorized-header (Auth.basic-challenge "new")
                          {@"WWW-Authenticate" [@"Basic realm=\"old\""]})
    "Response.unauthorized replaces a WWW-Authenticate in headers")
  (assert-equal test
    "1994-11-06 08:49:37"
    &(http-date "Sun, 06 Nov 1994 08:49:37 GMT")
    "HttpDate.parse reads an IMF-fixdate")
  (assert-equal test
    "1970-01-01 00:00:01"
    &(http-date "Thu, 01-Jan-1970 00:00:01 GMT")
    "HttpDate.parse reads a dashed four-digit-year date")
  (assert-equal test
    "1994-11-06 08:49:37"
    &(http-date "Sun, 06-Nov-94 08:49:37 GMT")
    "HttpDate.parse reads a dashed two-digit-year date")
  (assert-equal test
    "1970-01-01 00:00:00"
    &(http-date "Thu, 01-Jan-70 00:00:00 GMT")
    "HttpDate.parse reads the two-digit-year cookie-deletion date")
  (assert-equal test
    "1999-11-06 08:49:37"
    &(http-date "Sat, 06-Nov-1999 08:49:37 GMT")
    "a dashed four-digit year is not read as a two-digit one")
  (assert-equal test
    "1994-11-06 08:49:37"
    &(http-date "Sunday, 06-Nov-94 08:49:37 GMT")
    "HttpDate.parse reads an rfc850-date")
  (assert-equal test
    "1994-11-06 08:49:37"
    &(http-date "Sun Nov  6 08:49:37 1994")
    "HttpDate.parse reads an asctime-date")
  (assert-equal test
    "1994-11-16 08:49:37"
    &(http-date "Sun Nov 16 08:49:37 1994")
    "HttpDate.parse reads an asctime-date with a two-digit day")
  (assert-equal test
    "2037-01-01 00:00:00"
    &(http-date "Thursday, 01-Jan-37 00:00:00 GMT")
    "an rfc850 two-digit year under 69 lands in the 2000s")
  (assert-equal test
    "1969-01-01 00:00:00"
    &(http-date "Wednesday, 01-Jan-69 00:00:00 GMT")
    "an rfc850 two-digit year of 69 or over lands in the 1900s")
  (assert-equal test
    "unrecognized date format: not a real date"
    &(http-date "not a real date")
    "HttpDate.parse rejects a date in no known format")
  (assert-equal test
    "unrecognized date format: "
    &(http-date "")
    "HttpDate.parse rejects the empty string")
  (assert-equal test
    "2021-06-09 10:18:14"
    &(http-date &(HttpDate.format &(cookie-expires-fixture)))
    "HttpDate.format round-trips through HttpDate.parse")
  (assert-equal test
    "Sun, 06 Nov 1994 09:00:00 GMT"
    &(HttpDate.format &(zoned 1994 11 6 10 @"CET" 3600l))
    "HttpDate.format converts to UTC rather than relabelling local time")
  (assert-equal test
    "sid=xyz; Path=/; Expires=Sun, 06 Nov 1994 09:00:00 GMT; SameSite=Lax"
    &(Cookie.set
      &(Cookie.set-expires (cookie-base)
                           (Maybe.Just (zoned 1994 11 6 10 @"CET" 3600l))))
    "Cookie.set writes Expires in UTC")
  (assert-equal test
    "1994-11-06 08:49:37"
    &(cookie-expiry "id=abc; Expires=Sunday, 06-Nov-94 08:49:37 GMT")
    "parse-set accepts an rfc850 Expires")
  (assert-equal test
    "malformed expires date in set-cookie: unrecognized date format: not a real date"
    &(cookie-expiry "id=abc; Expires=not a real date")
    "parse-set still rejects an Expires in no known format")
  (assert-equal test
    "1970-01-01 00:00:01"
    &(resp-cookie-expiry
      "HTTP/1.1 200 OK\r\nSet-Cookie: sid=1; Expires=Thu, 01-Jan-1970 00:00:01 GMT; Path=/\r\n\r\n")
    "Response.parse accepts the standard cookie-deletion Set-Cookie header")

  ; ---- headers that are not valid UTF-8 ----
  (assert-false test
    (String.byte-starts-with? &(continuation 4) "path")
    "byte-starts-with? measures the prefix in bytes")
  (assert-true test
    (String.byte-ends-with? &(String.append &(continuation 4) "/") "/")
    "byte-ends-with? measures the suffix in bytes")
  (assert-equal test
    &(continuation 1)
    &(ctype-param
      &(String.append "multipart/form-data; boundary=" &(continuation 1))
      "boundary")
    "parse-params keeps a bare parameter value that is not valid UTF-8")
  (assert-equal test
    &(continuation 1)
    &(ctype-param
      &(String.append "multipart/form-data; boundary=\""
                      &(String.append &(continuation 1) "\""))
      "boundary")
    "parse-params unquotes a parameter value that is not valid UTF-8")
  (assert-equal test
    &(continuation 1)
    &(cc-directive &(String.append "max-age=" &(continuation 1)) "max-age")
    "CacheControl keeps a bare directive value that is not valid UTF-8")
  (assert-equal test
    &(continuation 1)
    &(cc-directive
      &(String.append "community=\"" &(String.append &(continuation 1) "\""))
      "community")
    "CacheControl unquotes a directive value that is not valid UTF-8")
  (assert-equal test
    "id=abc"
    &(cookie-summary
      &(String.append "id=abc; " &(String.append &(continuation 7) "=x")))
    "parse-set ignores a Set-Cookie attribute that is not valid UTF-8")
  (assert-equal test
    "sid=1"
    &(resp-cookie-summary
      &(String.append "HTTP/1.1 200 OK\r\nSet-Cookie: sid=1; "
                      &(String.append &(continuation 7) "=x\r\n\r\n")))
    "Response.parse survives a Set-Cookie attribute that is not valid UTF-8")
  (assert-equal test
    "en-US"
    &(pick-lang "en, de;q=0.5" &[@"en-US" (continuation 3)])
    "AcceptLanguage.negotiate tolerates an offer that is not valid UTF-8")
  (assert-equal test
    &(String.append "\"" &(String.append &(continuation 3) "\""))
    &(etag-verdict &(String.append "\"" &(String.append &(continuation 3) "\"")))
    "an entity-tag whose opaque-tag is not valid UTF-8 round-trips"))
