(load "Test.carp")
(load "../http.carp")
(use Test)

(def simple-get @"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
(def post-with-body
  @"POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: 13\r\n\r\n{\"key\":\"val\"}")
(def multi-header
  @"GET / HTTP/1.1\r\nHost: localhost\r\nAccept: text/html\r\nAccept: application/json\r\n\r\n")
(def with-cookies
  @"GET / HTTP/1.1\r\nHost: localhost\r\nCookie: a=1;b=2\r\n\r\n")

(defn parse-verb [s]
  (match (Request.parse s) (Result.Success r) @(Request.verb &r) _ @""))

(defn parse-version [s]
  (match (Request.parse s) (Result.Success r) @(Request.version &r) _ @""))

(defn parse-body [s]
  (match (Request.parse s) (Result.Success r) @(Request.body &r) _ @""))

(defn resp-code [s]
  (match (Response.parse s) (Result.Success r) @(Response.code &r) _ -1))

(defn resp-body [s]
  (match (Response.parse s) (Result.Success r) @(Response.body &r) _ @""))

; ---- multipart/form-data + MediaType test helpers ----
(defn mp-parts [body boundary]
  (match (Multipart.parse body boundary)
    (Result.Success ps) ps
    (Result.Error _) []))
(defn mp-name [ps i] @(FormPart.name (Array.unsafe-nth ps i)))
(defn mp-body [ps i] @(FormPart.body (Array.unsafe-nth ps i)))
(defn mp-fname [ps i]
  (Maybe.from @(FormPart.filename (Array.unsafe-nth ps i)) @"<none>"))
(defn mp-ctype [ps i]
  (Maybe.from @(FormPart.content-type (Array.unsafe-nth ps i)) @"<none>"))

(def mp-text
  @"--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhello\r\n--b--\r\n")
(def mp-file
  @"--b\r\nContent-Disposition: form-data; name=\"f\"; filename=\"up.txt\"\r\nContent-Type: text/plain\r\n\r\ndata\r\n--b--\r\n")
(def mp-two
  @"--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n--b\r\nContent-Disposition: form-data; name=\"c\"\r\n\r\n2\r\n--b--\r\n")

; ---- content negotiation (Accept) test helpers ----
(defn pick [accept offers]
  (match (Accept.negotiate accept offers)
    (Maybe.Just m) m
    (Maybe.Nothing) @"NONE"))

(defn range-mime [s i]
  (let [rs (Accept.parse s)]
    (fmt "%s/%s"
         (MediaRange.type (Array.unsafe-nth &rs i))
         (MediaRange.subtype (Array.unsafe-nth &rs i)))))

(defn req-pick [accept offers]
  (let [r (Request.get (URI.zero) [] {@"Accept" [@accept]} @"")]
    (match (Request.negotiate &r offers)
      (Maybe.Just m) m
      (Maybe.Nothing) @"NONE")))

(defn req-pick-noaccept [offers]
  (let [r (Request.get (URI.zero) [] (the (Map String (Array String)) {}) @"")]
    (match (Request.negotiate &r offers)
      (Maybe.Just m) m
      (Maybe.Nothing) @"NONE")))

(deftest test
  (assert-true test
    (match (Request.parse &simple-get) (Result.Success _) true _ false)
    "parse simple GET succeeds")

  (assert-equal test &(parse-verb &simple-get) "GET" "parse extracts verb")

  (assert-equal test
    &(parse-version &simple-get)
    "HTTP/1.1"
    "parse extracts version")

  (assert-equal test
    &(parse-body &post-with-body)
    "{\"key\":\"val\"}"
    "parse extracts body")

  (assert-equal test &(parse-verb &post-with-body) "POST" "parse POST verb")

  (assert-equal test
    2
    (match (Request.parse &multi-header)
      (Result.Success r)
        (Array.length &(Map.get-with-default (Request.headers &r) "Accept" &[]))
      _ 0)
    "multiple Accept headers collected")

  (assert-equal test
    2
    (match (Request.parse &with-cookies)
      (Result.Success r) (Array.length (Request.cookies &r))
      _ 0)
    "cookies parsed from Cookie header")

  (assert-true test
    (match (Request.parse "") (Result.Error _) true _ false)
    "empty string returns error")

  (assert-true test
    (match (Request.parse "garbage") (Result.Error _) true _ false)
    "garbage returns error")

  (assert-equal test
    200
    (resp-code "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi")
    "parse 200 response code")

  (assert-equal test
    &(resp-body "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi")
    "hi"
    "parse response body")

  (assert-equal test
    404
    (resp-code "HTTP/1.1 404 Not Found\r\n\r\n")
    "parse 404 response")

  (assert-true test
    (Response.ok? &(Response.init 200 @"OK" @"HTTP/1.1" [] {} @""))
    "ok? true for 200")

  (assert-true test
    (Response.client-error?
      &(Response.init 404 @"Not Found" @"HTTP/1.1" [] {} @""))
    "client-error? true for 404")

  (assert-true test
    (Response.server-error? &(Response.init 500 @"ISE" @"HTTP/1.1" [] {} @""))
    "server-error? true for 500")

  (assert-equal test
    &(let [req (Request.get (URI.zero) [] {} @"")]
      (match (Request.parse &(Request.str &req))
        (Result.Success r) @(Request.verb &r)
        _ @""))
    "GET"
    "request roundtrip preserves verb")

  (assert-true test
    (match (Cookie.parse "name=value")
      (Result.Success c)
        (and (= (Cookie.name &c) "name") (= (Cookie.value &c) "value"))
      _ false)
    "parse simple cookie")

  (assert-true test
    (match (Cookie.parse "bad") (Result.Error _) true _ false)
    "malformed cookie returns error")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Expires=Wed, 09 Jun 2021 10:18:14 GMT")
      (Result.Success c)
        (match @(Cookie.expires &c)
          (Maybe.Just d)
            (and (= 2021 @(Datetime.year &d))
                 (and (= 6 @(Datetime.month &d)) (= 9 @(Datetime.day &d))))
          (Maybe.Nothing) false)
      _ false)
    "parse-set extracts Expires date")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Expires=not a real date")
      (Result.Error _) true
      _ false)
    "parse-set rejects malformed Expires date")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Partitioned")
      (Result.Success c) (= (Cookie.name &c) "id")
      _ false)
    "parse-set ignores unknown attribute Partitioned")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Priority=High")
      (Result.Success c) (= (Cookie.value &c) "abc")
      _ false)
    "parse-set ignores unknown attribute Priority=High")

  (assert-true test
    (match (Cookie.parse-set
        "id=abc; Path=/; Partitioned; Secure; Priority=High")
      (Result.Success c) (and (= (Cookie.path &c) "/") @(Cookie.secure &c))
      _ false)
    "parse-set handles mix of known and unknown attributes")

  (assert-true test
    (match (Cookie.parse "session=YWJjZA==")
      (Result.Success c)
        (and (= (Cookie.name &c) "session") (= (Cookie.value &c) "YWJjZA=="))
      _ false)
    "parse handles '=' in cookie value")

  (assert-equal test
    2
    (match (Request.parse "GET / HTTP/1.1\r\ncookie: a=1;b=2\r\n\r\n")
      (Result.Success r) (Array.length (Request.cookies &r))
      _ 0)
    "lowercase 'cookie:' header is recognized")

  (assert-equal test
    1
    (match (Response.parse "HTTP/1.1 200 OK\r\nset-cookie: id=abc\r\n\r\n")
      (Result.Success r) (Array.length (Response.cookies &r))
      _ 0)
    "lowercase 'set-cookie:' header is recognized")

  (assert-equal test 200 Status.ok "Status.ok is 200")

  (assert-equal test 404 Status.not-found "Status.not-found is 404")

  (assert-equal test &(Status.reason 404) "Not Found" "Status.reason for 404")

  (assert-equal test &(Status.reason 200) "OK" "Status.reason for 200")

  (assert-equal test
    &(Status.reason 999)
    "Unknown"
    "Status.reason for unknown code")

  (assert-true test
    (match (Request.parse "GET / HTTP/1.1\r\nContent-Type: text/html\r\n\r\n")
      (Result.Success r)
        (match (Request.header &r "content-type")
          (Maybe.Just v) (= &v "text/html")
          _ false)
      _ false)
    "header lookup is case-insensitive")

  (assert-true test
    (match (Request.parse "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
      (Result.Success r) (Maybe.nothing? &(Request.header &r "X-Missing"))
      _ false)
    "header returns Nothing for missing key")

  (assert-equal test
    "carp"
    &(match (the (Result (Map String String) String)
                 (Form.parse "name=carp&version=1"))
      (Result.Success m) (Map.get &m "name")
      _ @"")
    "Form.parse extracts key")

  (assert-equal test
    "1"
    &(match (the (Result (Map String String) String)
                 (Form.parse "name=carp&version=1"))
      (Result.Success m) (Map.get &m "version")
      _ @"")
    "Form.parse extracts second key")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Form.parse "msg=hello%20world"))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "Form.parse decodes percent-encoded space")

  (assert-equal test
    ""
    &(match (the (Result (Map String String) String) (Form.parse "flag"))
      (Result.Success m) (Map.get &m "flag")
      _ @"FAIL")
    "Form.parse handles key without value")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Form.parse "msg=hello+world"))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "Form.parse decodes + as space")

  (assert-equal test
    "a b c"
    &(match (the (Result (Map String String) String) (Form.parse "x=a+b+c"))
      (Result.Success m) (Map.get &m "x")
      _ @"")
    "Form.parse decodes multiple + as spaces")

  (assert-equal test
    "+"
    &(match (the (Result (Map String String) String) (Form.parse "x=%2B"))
      (Result.Success m) (Map.get &m "x")
      _ @"")
    "Form.parse decodes %2B as literal +")

  (assert-equal test
    "a b"
    &(match (the (Result (Map String String) String) (Form.parse "key+name=a+b"))
      (Result.Success m) (Map.get &m "key name")
      _ @"")
    "Form.parse decodes + in keys too")

  (assert-true test
    (Request.ignore-body? &(Request.request @"HEAD" (URI.zero) [] {} @""))
    "ignore-body? true for HEAD")

  (assert-false test
    (Request.ignore-body? &(Request.request @"GET" (URI.zero) [] {} @""))
    "ignore-body? false for GET")

  (assert-false test
    (Request.ignore-body? &(Request.request @"POST" (URI.zero) [] {} @"body"))
    "ignore-body? false for POST")

  (assert-equal test
    "bar"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"foo=bar&baz=qux")))
      (Result.Success m) (Map.get &m "foo")
      _ @"")
    "form-data extracts key from POST body")

  (assert-equal test
    "qux"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"foo=bar&baz=qux")))
      (Result.Success m) (Map.get &m "baz")
      _ @"")
    "form-data extracts second key from POST body")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"msg=hello%20world")))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "form-data decodes percent-encoded values")

  (assert-true test
    (match (the (Result (Map String String) String)
                (Request.form-data &(Request.get (URI.zero) [] {} @"")))
      (Result.Success m) (= 0 (Map.length &m))
      _ false)
    "form-data on empty body returns empty map")

  (assert-equal test
    "name=carp"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "name" "carp")
      (Form.encode &m))
    "encode single pair")

  (assert-equal test
    "msg=hello+world"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "msg" "hello world")
      (Form.encode &m))
    "encode space as +")

  (assert-equal test
    "x=%26"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "x" "&")
      (Form.encode &m))
    "encode & as %26")

  (assert-equal test
    "k=a%2bb"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "k" "a+b")
      (Form.encode &m))
    "encode literal + as %2b")

  (assert-equal test
    "key+name=val"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "key name" "val")
      (Form.encode &m))
    "encode space in key as +")

  (assert-true test
    (let-do [m (the (Map String String) {})]
      (Map.put! &m "a" "1")
      (match (the (Result (Map String String) String)
                  (Form.parse &(Form.encode &m)))
        (Result.Success parsed) (= &parsed &m)
        _ false))
    "encode/parse roundtrip single pair")

  (assert-equal test
    2
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps) (Array.length &ps)
      _ 0)
    "parse-pairs returns correct count")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 0)) "name")
          (= (Pair.b (Array.unsafe-nth &ps 0)) "carp"))
      _ false)
    "parse-pairs first pair is correct")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 1)) "version")
          (= (Pair.b (Array.unsafe-nth &ps 1)) "1"))
      _ false)
    "parse-pairs second pair is correct")

  (assert-equal test
    3
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "x=1&x=2&x=3"))
      (Result.Success ps) (Array.length &ps)
      _ 0)
    "parse-pairs preserves duplicate keys")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "msg=hello+world"))
      (Result.Success ps) (= (Pair.b (Array.unsafe-nth &ps 0)) "hello world")
      _ false)
    "parse-pairs decodes + as space")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "flag"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 0)) "flag")
          (= (Pair.b (Array.unsafe-nth &ps 0)) ""))
      _ false)
    "parse-pairs handles key without value")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "x=%26%3D"))
      (Result.Success ps) (= (Pair.b (Array.unsafe-nth &ps 0)) "&=")
      _ false)
    "parse-pairs decodes percent-encoded values")
  ; ---- MediaType ----
  (assert-equal test
    "multipart/form-data"
    &(match (MediaType.parse "multipart/form-data; boundary=xyz")
      (Result.Success mt) (MediaType.mime &mt)
      (Result.Error _) @"ERR")
    "MediaType.parse extracts type/subtype")
  (assert-equal test
    "xyz"
    &(match (MediaType.parse "multipart/form-data; boundary=xyz")
      (Result.Success mt) (Maybe.from (MediaType.param &mt "boundary") @"?")
      (Result.Error _) @"ERR")
    "MediaType.parse extracts the boundary parameter")
  (assert-equal test
    "multipart/form-data"
    &(match (MediaType.parse "Multipart/Form-Data ; boundary=xyz")
      (Result.Success mt) (MediaType.mime &mt)
      (Result.Error _) @"ERR")
    "MediaType lowercases type/subtype and tolerates whitespace before ;")
  (assert-equal test
    "xyz"
    &(match (MediaType.parse "multipart/form-data; boundary=\"xyz\"")
      (Result.Success mt) (Maybe.from (MediaType.param &mt "boundary") @"?")
      (Result.Error _) @"ERR")
    "MediaType unquotes a quoted parameter value")
  (assert-equal test
    "xyz"
    &(match (MediaType.parse "multipart/form-data; BOUNDARY=xyz")
      (Result.Success mt) (Maybe.from (MediaType.param &mt "boundary") @"?")
      (Result.Error _) @"ERR")
    "MediaType parameter lookup is case-insensitive")
  (assert-true test
    (match (MediaType.parse "notamediatype")
      (Result.Error _) true
      (Result.Success _) false)
    "MediaType.parse errors without a subtype")
  (assert-equal test
    "a;b"
    &(let [ps (MediaType.parse-params "x/y; n=\"a;b\"")]
      (Maybe.from (Map.get-maybe &ps "n") @"?"))
    "parse-params keeps a semicolon inside a quoted value")

  ; ---- Multipart.parse ----
  (assert-equal test
    1
    (Array.length &(mp-parts &mp-text "b"))
    "one text part parses to one FormPart")
  (assert-equal test "a" &(mp-name &(mp-parts &mp-text "b") 0) "text part name")
  (assert-equal test
    "hello"
    &(mp-body &(mp-parts &mp-text "b") 0)
    "text part body")
  (assert-equal test
    "<none>"
    &(mp-fname &(mp-parts &mp-text "b") 0)
    "text part has no filename")
  (assert-equal test
    "up.txt"
    &(mp-fname &(mp-parts &mp-file "b") 0)
    "file part filename")
  (assert-equal test
    "text/plain"
    &(mp-ctype &(mp-parts &mp-file "b") 0)
    "file part content-type")
  (assert-equal test
    "data"
    &(mp-body &(mp-parts &mp-file "b") 0)
    "file part body")
  (assert-equal test
    2
    (Array.length &(mp-parts &mp-two "b"))
    "two parts parse to two FormParts")
  (assert-equal test
    "c"
    &(mp-name &(mp-parts &mp-two "b") 1)
    "second part name preserved in order")
  (assert-equal test
    "line1\r\nline2"
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline1\r\nline2\r\n--b--\r\n"
        "b")
      0)
    "CRLF inside a part body is preserved")
  (assert-equal test
    ""
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n\r\n--b--\r\n"
        "b")
      0)
    "empty part body parses to the empty string")
  (assert-equal test
    "z"
    &(mp-name
      &(mp-parts
        "--b\r\ncontent-disposition: form-data; name=\"z\"\r\n\r\nq\r\n--b--\r\n"
        "b")
      0)
    "a lower-case Content-Disposition header is recognized")
  (assert-equal test
    "tail"
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\ntail\r\n--b--"
        "b")
      0)
    "a closing delimiter without a trailing CRLF still parses")
  (assert-equal test
    "ok"
    &(mp-body
      &(mp-parts
        "preamble\r\n--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nok\r\n--b--\r\n"
        "b")
      0)
    "a preamble before the first boundary is ignored")
  (assert-equal test
    "foo--bbar"
    &(mp-body
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nfoo--bbar\r\n--b--\r\n"
        "b")
      0)
    "a --boundary substring inside a body is not treated as a delimiter")
  (assert-equal test
    "a\"b"
    &(mp-name
      &(mp-parts
        "--b\r\nContent-Disposition: form-data; name=\"a\\\"b\"\r\n\r\nv\r\n--b--\r\n"
        "b")
      0)
    "an escaped quote inside a quoted name is unescaped")
  (assert-equal test
    "v"
    &(mp-body
      &(mp-parts
        "------CarpBoundary9\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nv\r\n------CarpBoundary9--\r\n"
        "----CarpBoundary9")
      0)
    "a boundary with leading dashes round-trips")
  (assert-true test
    (match (Multipart.parse "no boundary here" "b")
      (Result.Error _) true
      (Result.Success _) false)
    "a missing boundary delimiter is an error")

  ; ---- Request.multipart-data ----
  (assert-equal test
    "world"
    &(let [r (Request.post (URI.zero)
                           []
                           {@"Content-Type" [@"multipart/form-data; boundary=b"]}
                           @"--b\r\nContent-Disposition: form-data; name=\"greeting\"\r\n\r\nworld\r\n--b--\r\n")]
      (match (Request.multipart-data &r)
        (Result.Success ps) (mp-body &ps 0)
        (Result.Error _) @"ERR"))
    "Request.multipart-data decodes the body using the header boundary")
  (assert-true test
    (let [r (Request.post (URI.zero)
                          []
                          {@"Content-Type" [@"application/json"]}
                          @"{}")]
      (match (Request.multipart-data &r)
        (Result.Error _) true
        (Result.Success _) false))
    "Request.multipart-data errors on a non-multipart content type")
  (assert-true test
    (let [r (Request.post (URI.zero)
                          []
                          {@"Content-Type" [@"multipart/form-data"]}
                          @"--b--")]
      (match (Request.multipart-data &r)
        (Result.Error _) true
        (Result.Success _) false))
    "Request.multipart-data errors when the boundary parameter is absent")

  ; ---- content negotiation via the Accept header (RFC 7231 §5.3.2) ----
  (assert-equal test
    "text/html"
    &(pick "text/html" &[@"text/html"])
    "a range with no q defaults to weight 1")
  (assert-equal test
    "application/json"
    &(pick
      "text/html;q=0.8, application/json;q=0.9"
      &[@"text/html" @"application/json"])
    "the higher-weighted media type wins")
  (assert-equal test
    "image/png"
    &(pick "*/*;q=0.9, text/html;q=0.1" &[@"text/html" @"image/png"])
    "a specific range overrides */* for the type it names")
  (assert-equal test
    "image/png"
    &(pick "*/*, image/gif;q=0" &[@"image/gif" @"image/png"])
    "q=0 marks a type unacceptable even under */*")
  (assert-equal test
    "text/plain"
    &(pick "text/*" &[@"text/plain" @"application/json"])
    "a type/* range matches only that type")
  (assert-equal test
    "NONE"
    &(pick "application/json" &[@"text/html"])
    "no matching range means no acceptable offer")
  (assert-equal test
    "text/html"
    &(pick "" &[@"text/html" @"application/json"])
    "an empty Accept accepts anything and yields the first offer")
  (assert-equal test
    "application/json"
    &(pick "text/html, application/json" &[@"application/json" @"text/html"])
    "equal weights are broken by offer order")
  (assert-equal test
    "text/html"
    &(pick
      "  text/html ,  application/json ; q=0.9 "
      &[@"application/json" @"text/html"])
    "whitespace around ranges and parameters is tolerated")
  (assert-equal test
    "text/html"
    &(pick "text/html;q=bogus, image/png;q=0.5" &[@"text/html" @"image/png"])
    "an unparseable q falls back to weight 1")
  (assert-true test
    (= 3
       (Array.length
         &(Accept.parse "text/html, application/xml;q=0.9, */*;q=0.8")))
    "parse yields one entry per range")
  (assert-equal test
    "application/xml"
    &(range-mime "text/html, application/xml;q=0.9" 1)
    "a parsed range keeps its type and subtype")
  (assert-equal test
    "*/*"
    &(range-mime "text/html, */*;q=0.8" 1)
    "a wildcard range parses to */*")
  (assert-equal test
    "application/json"
    &(req-pick
      "text/html;q=0.5, application/json;q=0.9"
      &[@"text/html" @"application/json"])
    "Request.negotiate honors the request's Accept header")
  (assert-equal test
    "text/html"
    &(req-pick-noaccept &[@"text/html" @"application/json"])
    "Request.negotiate with no Accept header accepts anything"))
