(load "Test.carp")
(load "../http.carp")
(use Test)

(def simple-get @"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
(def post-with-body
  @"POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: 13\r\n\r\n{\"key\":\"val\"}")
(def multi-header
  @"GET / HTTP/1.1\r\nHost: localhost\r\nAccept: text/html\r\nAccept: application/json\r\n\r\n")
(def with-cookies
  @"GET / HTTP/1.1\r\nHost: localhost\r\nCookie: a=1;b=2\r\n\r\n")

(defn parse-verb [s]
  (match (Request.parse s) (Result.Success r) @(Request.verb &r) _ @""))

(defn parse-version [s]
  (match (Request.parse s) (Result.Success r) @(Request.version &r) _ @""))

(defn parse-body [s]
  (match (Request.parse s) (Result.Success r) @(Request.body &r) _ @""))

(defn resp-code [s]
  (match (Response.parse s) (Result.Success r) @(Response.code &r) _ -1))

(defn resp-body [s]
  (match (Response.parse s) (Result.Success r) @(Response.body &r) _ @""))

(deftest test
  (assert-true test
    (match (Request.parse &simple-get) (Result.Success _) true _ false)
    "parse simple GET succeeds")

  (assert-equal test &(parse-verb &simple-get) "GET" "parse extracts verb")

  (assert-equal test
    &(parse-version &simple-get)
    "HTTP/1.1"
    "parse extracts version")

  (assert-equal test
    &(parse-body &post-with-body)
    "{\"key\":\"val\"}"
    "parse extracts body")

  (assert-equal test &(parse-verb &post-with-body) "POST" "parse POST verb")

  (assert-equal test
    2
    (match (Request.parse &multi-header)
      (Result.Success r)
        (Array.length &(Map.get-with-default (Request.headers &r) "Accept" &[]))
      _ 0)
    "multiple Accept headers collected")

  (assert-equal test
    2
    (match (Request.parse &with-cookies)
      (Result.Success r) (Array.length (Request.cookies &r))
      _ 0)
    "cookies parsed from Cookie header")

  (assert-true test
    (match (Request.parse "") (Result.Error _) true _ false)
    "empty string returns error")

  (assert-true test
    (match (Request.parse "garbage") (Result.Error _) true _ false)
    "garbage returns error")

  (assert-equal test
    200
    (resp-code "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi")
    "parse 200 response code")

  (assert-equal test
    &(resp-body "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi")
    "hi"
    "parse response body")

  (assert-equal test
    404
    (resp-code "HTTP/1.1 404 Not Found\r\n\r\n")
    "parse 404 response")

  (assert-true test
    (Response.ok? &(Response.init 200 @"OK" @"HTTP/1.1" [] {} @""))
    "ok? true for 200")

  (assert-true test
    (Response.client-error?
      &(Response.init 404 @"Not Found" @"HTTP/1.1" [] {} @""))
    "client-error? true for 404")

  (assert-true test
    (Response.server-error? &(Response.init 500 @"ISE" @"HTTP/1.1" [] {} @""))
    "server-error? true for 500")

  (assert-equal test
    &(let [req (Request.get (URI.zero) [] {} @"")]
      (match (Request.parse &(Request.str &req))
        (Result.Success r) @(Request.verb &r)
        _ @""))
    "GET"
    "request roundtrip preserves verb")

  (assert-true test
    (match (Cookie.parse "name=value")
      (Result.Success c)
        (and (= (Cookie.name &c) "name") (= (Cookie.value &c) "value"))
      _ false)
    "parse simple cookie")

  (assert-true test
    (match (Cookie.parse "bad") (Result.Error _) true _ false)
    "malformed cookie returns error")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Expires=Wed, 09 Jun 2021 10:18:14 GMT")
      (Result.Success c)
        (match @(Cookie.expires &c)
          (Maybe.Just d)
            (and (= 2021 @(Datetime.year &d))
                 (and (= 6 @(Datetime.month &d)) (= 9 @(Datetime.day &d))))
          (Maybe.Nothing) false)
      _ false)
    "parse-set extracts Expires date")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Expires=not a real date")
      (Result.Error _) true
      _ false)
    "parse-set rejects malformed Expires date")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Partitioned")
      (Result.Success c) (= (Cookie.name &c) "id")
      _ false)
    "parse-set ignores unknown attribute Partitioned")

  (assert-true test
    (match (Cookie.parse-set "id=abc; Priority=High")
      (Result.Success c) (= (Cookie.value &c) "abc")
      _ false)
    "parse-set ignores unknown attribute Priority=High")

  (assert-true test
    (match (Cookie.parse-set
        "id=abc; Path=/; Partitioned; Secure; Priority=High")
      (Result.Success c) (and (= (Cookie.path &c) "/") @(Cookie.secure &c))
      _ false)
    "parse-set handles mix of known and unknown attributes")

  (assert-true test
    (match (Cookie.parse "session=YWJjZA==")
      (Result.Success c)
        (and (= (Cookie.name &c) "session") (= (Cookie.value &c) "YWJjZA=="))
      _ false)
    "parse handles '=' in cookie value")

  (assert-equal test
    2
    (match (Request.parse "GET / HTTP/1.1\r\ncookie: a=1;b=2\r\n\r\n")
      (Result.Success r) (Array.length (Request.cookies &r))
      _ 0)
    "lowercase 'cookie:' header is recognized")

  (assert-equal test
    1
    (match (Response.parse "HTTP/1.1 200 OK\r\nset-cookie: id=abc\r\n\r\n")
      (Result.Success r) (Array.length (Response.cookies &r))
      _ 0)
    "lowercase 'set-cookie:' header is recognized")

  (assert-equal test 200 Status.ok "Status.ok is 200")

  (assert-equal test 404 Status.not-found "Status.not-found is 404")

  (assert-equal test &(Status.reason 404) "Not Found" "Status.reason for 404")

  (assert-equal test &(Status.reason 200) "OK" "Status.reason for 200")

  (assert-equal test
    &(Status.reason 999)
    "Unknown"
    "Status.reason for unknown code")

  (assert-true test
    (match (Request.parse "GET / HTTP/1.1\r\nContent-Type: text/html\r\n\r\n")
      (Result.Success r)
        (match (Request.header &r "content-type")
          (Maybe.Just v) (= &v "text/html")
          _ false)
      _ false)
    "header lookup is case-insensitive")

  (assert-true test
    (match (Request.parse "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
      (Result.Success r) (Maybe.nothing? &(Request.header &r "X-Missing"))
      _ false)
    "header returns Nothing for missing key")

  (assert-equal test
    "carp"
    &(match (the (Result (Map String String) String)
                 (Form.parse "name=carp&version=1"))
      (Result.Success m) (Map.get &m "name")
      _ @"")
    "Form.parse extracts key")

  (assert-equal test
    "1"
    &(match (the (Result (Map String String) String)
                 (Form.parse "name=carp&version=1"))
      (Result.Success m) (Map.get &m "version")
      _ @"")
    "Form.parse extracts second key")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Form.parse "msg=hello%20world"))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "Form.parse decodes percent-encoded space")

  (assert-equal test
    ""
    &(match (the (Result (Map String String) String) (Form.parse "flag"))
      (Result.Success m) (Map.get &m "flag")
      _ @"FAIL")
    "Form.parse handles key without value")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Form.parse "msg=hello+world"))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "Form.parse decodes + as space")

  (assert-equal test
    "a b c"
    &(match (the (Result (Map String String) String) (Form.parse "x=a+b+c"))
      (Result.Success m) (Map.get &m "x")
      _ @"")
    "Form.parse decodes multiple + as spaces")

  (assert-equal test
    "+"
    &(match (the (Result (Map String String) String) (Form.parse "x=%2B"))
      (Result.Success m) (Map.get &m "x")
      _ @"")
    "Form.parse decodes %2B as literal +")

  (assert-equal test
    "a b"
    &(match (the (Result (Map String String) String) (Form.parse "key+name=a+b"))
      (Result.Success m) (Map.get &m "key name")
      _ @"")
    "Form.parse decodes + in keys too")

  (assert-true test
    (Request.ignore-body? &(Request.request @"HEAD" (URI.zero) [] {} @""))
    "ignore-body? true for HEAD")

  (assert-false test
    (Request.ignore-body? &(Request.request @"GET" (URI.zero) [] {} @""))
    "ignore-body? false for GET")

  (assert-false test
    (Request.ignore-body? &(Request.request @"POST" (URI.zero) [] {} @"body"))
    "ignore-body? false for POST")

  (assert-equal test
    "bar"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"foo=bar&baz=qux")))
      (Result.Success m) (Map.get &m "foo")
      _ @"")
    "form-data extracts key from POST body")

  (assert-equal test
    "qux"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"foo=bar&baz=qux")))
      (Result.Success m) (Map.get &m "baz")
      _ @"")
    "form-data extracts second key from POST body")

  (assert-equal test
    "hello world"
    &(match (the (Result (Map String String) String)
                 (Request.form-data
                   &(Request.post (URI.zero) [] {} @"msg=hello%20world")))
      (Result.Success m) (Map.get &m "msg")
      _ @"")
    "form-data decodes percent-encoded values")

  (assert-true test
    (match (the (Result (Map String String) String)
                (Request.form-data &(Request.get (URI.zero) [] {} @"")))
      (Result.Success m) (= 0 (Map.length &m))
      _ false)
    "form-data on empty body returns empty map")

  (assert-equal test
    "name=carp"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "name" "carp")
      (Form.encode &m))
    "encode single pair")

  (assert-equal test
    "msg=hello+world"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "msg" "hello world")
      (Form.encode &m))
    "encode space as +")

  (assert-equal test
    "x=%26"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "x" "&")
      (Form.encode &m))
    "encode & as %26")

  (assert-equal test
    "k=a%2bb"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "k" "a+b")
      (Form.encode &m))
    "encode literal + as %2b")

  (assert-equal test
    "key+name=val"
    &(let-do [m (the (Map String String) {})]
      (Map.put! &m "key name" "val")
      (Form.encode &m))
    "encode space in key as +")

  (assert-true test
    (let-do [m (the (Map String String) {})]
      (Map.put! &m "a" "1")
      (match (the (Result (Map String String) String)
                  (Form.parse &(Form.encode &m)))
        (Result.Success parsed) (= &parsed &m)
        _ false))
    "encode/parse roundtrip single pair")

  (assert-equal test
    2
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps) (Array.length &ps)
      _ 0)
    "parse-pairs returns correct count")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 0)) "name")
          (= (Pair.b (Array.unsafe-nth &ps 0)) "carp"))
      _ false)
    "parse-pairs first pair is correct")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "name=carp&version=1"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 1)) "version")
          (= (Pair.b (Array.unsafe-nth &ps 1)) "1"))
      _ false)
    "parse-pairs second pair is correct")

  (assert-equal test
    3
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "x=1&x=2&x=3"))
      (Result.Success ps) (Array.length &ps)
      _ 0)
    "parse-pairs preserves duplicate keys")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "msg=hello+world"))
      (Result.Success ps) (= (Pair.b (Array.unsafe-nth &ps 0)) "hello world")
      _ false)
    "parse-pairs decodes + as space")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "flag"))
      (Result.Success ps)
        (and
          (= (Pair.a (Array.unsafe-nth &ps 0)) "flag")
          (= (Pair.b (Array.unsafe-nth &ps 0)) ""))
      _ false)
    "parse-pairs handles key without value")

  (assert-true test
    (match (the
        (Result (Array (Pair String String)) String)
        (Form.parse-pairs "x=%26%3D"))
      (Result.Success ps) (= (Pair.b (Array.unsafe-nth &ps 0)) "&=")
      _ false)
    "parse-pairs decodes percent-encoded values"))
